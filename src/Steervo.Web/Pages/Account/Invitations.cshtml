@page
@model Steervo.Web.Pages.Account.InvitationsModel
@{ ViewData["Title"] = T["Invitations"]; }
<div class="surface-heading"><div><p class="eyebrow">@T["Installation"]</p><h1>@T["Invitations"]</h1><p class="muted">@T["InvitationsIntro"]</p></div><button type="button" id="invite-person" class="button primary" data-editor-open="invitation-editor" aria-controls="invitation-editor" aria-haspopup="dialog"><partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />@T["InvitePerson"]</button></div>
<section class="workspace-surface invitation-workspace"><div class="surface-heading"><div><h2 id="invitations-title" tabindex="-1" data-return-focus>@T["SentInvitations"]</h2><p class="muted">@T["InvitationAccessHelp"]</p></div></div>
@if (Model.Notice is not null) { <p class="notice success" role="status">@Model.Notice</p> }
@if (!Model.Failed && !ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="editor-error" role="alert"></div> }
@if (Model.Invitations.Count == 0) { <div class="canvas-empty account-empty"><span class="access-symbol"><partial name="/Pages/Shared/_Icon.cshtml" model='"people"' /></span><div><h3>@T["NoInvitations"]</h3><p>@T["NoInvitationHelp"]</p></div></div> }
@foreach (var invitation in Model.Invitations)
{
    var pending = !invitation.Accepted && invitation.ExpiresAt > DateTimeOffset.UtcNow;
    <article class="invitation-row" data-invitation="@invitation.Id"><div><h3>@invitation.Email.ToLowerInvariant()</h3><p class="micro">@T["ValidUntil"] <time datetime="@invitation.ExpiresAt.ToString("O")">@invitation.ExpiresAt.ToString("g")</time></p></div><span class="invitation-status @(invitation.Accepted ? "accepted" : pending ? "pending" : "expired")">@T[invitation.Accepted ? "Accepted" : pending ? "Pending" : "Expired"]</span>
    @if (pending) { <form id="revoke-invitation-@invitation.Id" method="post" hx-post="@Request.Path" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-operation data-retain-on-error><input type="hidden" name="action" value="revoke" /><input type="hidden" name="id" value="@invitation.Id" /><button type="submit" class="text-button">@T["Revoke"]</button></form> }</article>
}
</section>
<dialog id="invitation-editor" class="side-sheet" data-editor data-opener="invite-person" aria-labelledby="invitation-title" data-open-on-load="@Model.Failed.ToString().ToLowerInvariant()">
<div class="editor-heading"><div><p class="editor-context">@T["Invitations"]</p><h2 id="invitation-title">@T["InvitePerson"]</h2></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
<p class="editor-help">@T["InvitationHelp"]</p><div class="editor-error" role="alert" tabindex="-1" hidden="@(!Model.Failed)"><div asp-validation-summary="All"></div></div>
<form method="post" hx-post="@Request.Path" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-guard-draft data-retain-on-error><label asp-for="Name">@T["Name"]</label><input asp-for="Name" required maxlength="160" autocomplete="name" data-editor-focus /><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" required maxlength="254" autocomplete="email" /><p class="editor-help">@T["InvitationAccessHelp"]</p><partial name="/Pages/Shared/_EditorActions.cshtml" model='new Steervo.Web.Pages.Shared.EditorActions("send-invitation", T["SendInvitation"].Value)' /></form>
</dialog>
