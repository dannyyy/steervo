@page
@model Steervo.Web.Pages.Account.InvitationsModel
@{ ViewData["Title"] = T["Invitations"]; }
<div class="page-heading"><div><p class="eyebrow">@T["Installation"]</p><h1>@T["Invitations"]</h1><p class="muted">@T["InvitationsIntro"]</p></div></div>
<div class="overview-grid"><section class="panel"><h2>@T["SentInvitations"]</h2>@if (Model.Invitations.Count == 0) { <div class="empty-state"><h3>@T["NoInvitations"]</h3><p>@T["NoInvitationHelp"]</p></div> }
@foreach (var invitation in Model.Invitations) { <article class="invitation-row"><div><h3>@invitation.Email</h3><p class="micro">@T[invitation.Accepted ? "Accepted" : invitation.ExpiresAt <= DateTimeOffset.UtcNow ? "Expired" : "Pending"] · @T["ValidUntil"] @invitation.ExpiresAt.ToString("g")</p></div>@if (!invitation.Accepted && invitation.ExpiresAt > DateTimeOffset.UtcNow) { <form method="post"><input type="hidden" name="action" value="revoke" /><input type="hidden" name="id" value="@invitation.Id" /><button class="text-button">@T["Revoke"]</button></form> }</article> }</section>
<section class="panel"><h2>@T["InvitePerson"]</h2><p class="muted">@T["InvitationHelp"]</p>@if (Model.Notice is not null) { <p class="notice success" role="status">@Model.Notice</p> }<form method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name">@T["Name"]</label><input asp-for="Name" required maxlength="160" /><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" required maxlength="254" /><button class="button primary full">@T["SendInvitation"] →</button></form></section></div>
