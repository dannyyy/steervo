@page
@model Steervo.Web.Pages.Auth.SetupModel
@{ ViewData["Title"] = T["Setup"]; }
<div class="auth-layout"><div class="auth-intro"><p class="eyebrow">@T["FreshStart"]</p><h1>@T["SetupHeading"]</h1><p class="lead">@T["SetupIntro"]</p><img class="auth-speedometer" src="~/images/speedometer.svg" asp-append-version="true" width="480" height="276" alt="" aria-hidden="true" /></div>
<section class="panel auth-card"><h2>@T["Setup"]</h2><p class="muted">@T["SetupHelp"]</p><form method="post">
<div asp-validation-summary="All" class="validation" role="alert"></div>
<label asp-for="Token">@T["SetupToken"]</label><input asp-for="Token" type="password" required autocomplete="off" />
<label asp-for="Name">@T["Name"]</label><input asp-for="Name" required maxlength="160" autocomplete="name" />
<label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" required maxlength="254" autocomplete="email" />
<button class="button primary full">@T["ConfirmEmail"] →</button></form></section></div>
