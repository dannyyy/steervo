@page
@model Steervo.Web.Pages.Auth.LoginModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ ViewData["Title"] = T["SignIn"]; var passkeyOrigin = new Uri(Configuration["PublicUrl"] ?? "http://localhost:5180").GetLeftPart(UriPartial.Authority); }
<div class="workspace-surface access-workspace">
    <div class="auth-intro"><p class="eyebrow">@T["WelcomeBack"]</p><h1>@T["SignInHeading"]</h1><p class="lead">@T["SignInIntro"]</p><partial name="_AccessContext" /></div>
    <section class="auth-card"><h2>@T["SignIn"]</h2><p class="muted">@T["InvitationOnly"]</p>
        <form id="login-code-form" method="post" hx-post="@Request.Path@Request.QueryString" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-request-form data-retain-on-error><input asp-for="ReturnUrl" type="hidden" /><div class="editor-error" role="alert" tabindex="-1" hidden></div><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" required autocomplete="username webauthn" maxlength="254" /><button type="submit" class="button primary full">@T["SendCode"] <partial name="/Pages/Shared/_Icon.cshtml" model='"arrow"' /></button></form>
        <div class="divider">@T["Or"]</div>
        <form method="post" id="login-passkey-form" data-passkey="get" data-options="/Auth/Login?handler=Options" action="/Auth/Login?handler=Passkey"
              data-origin="@passkeyOrigin" data-error="@T["PasskeyFailed"]"
              data-secure-error="@T["PasskeySecureContextRequired", passkeyOrigin]" data-origin-error="@T["PasskeyOriginMismatch", passkeyOrigin]"
              data-browser-error="@T["PasskeyBrowserUnsupported"]" data-cancelled-error="@T["PasskeyCancelled"]"
              data-duplicate-error="@T["PasskeyAlreadyRegistered"]" data-security-error="@T["PasskeySecurityError", passkeyOrigin]"
              data-session-error="@T["PasskeySessionExpired"]" data-rate-error="@T["PasskeyRateLimited"]">
            @Html.AntiForgeryToken()<input name="ReturnUrl" value="@Model.ReturnUrl" type="hidden" /><button class="button secondary full" type="submit">@T["SignInPasskey"]</button><p class="editor-error" role="alert" tabindex="-1" data-passkey-error hidden></p>
        </form>
        <p class="micro">@T["RecoveryNote"]</p>
    </section>
</div>

@section Scripts { <script src="~/js/passkeys.js" asp-append-version="true" defer></script> }
