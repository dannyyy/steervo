@page
@model Steervo.Web.Pages.Auth.LoginModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ ViewData["Title"] = T["SignIn"]; var passkeyOrigin = new Uri(Configuration["PublicUrl"] ?? "http://localhost:5180").GetLeftPart(UriPartial.Authority); }
<div class="auth-layout">
    <div class="auth-intro"><p class="eyebrow">@T["WelcomeBack"]</p><h1>@T["SignInHeading"]</h1><p class="lead">@T["SignInIntro"]</p><img class="auth-speedometer" src="~/images/speedometer.svg" asp-append-version="true" width="480" height="276" alt="" aria-hidden="true" /></div>
    <section class="panel auth-card"><h2>@T["SignIn"]</h2><p class="muted">@T["InvitationOnly"]</p>
        <form method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Email">@T["Email"]</label><input asp-for="Email" type="email" required autocomplete="username webauthn" maxlength="254" /><button class="button primary full">@T["SendCode"] <span aria-hidden="true">→</span></button></form>
        <div class="divider">@T["Or"]</div>
        <form method="post" data-passkey="get" data-options="/Auth/Login?handler=Options" action="/Auth/Login?handler=Passkey"
              data-origin="@passkeyOrigin" data-error="@T["PasskeyFailed"]"
              data-secure-error="@T["PasskeySecureContextRequired", passkeyOrigin]" data-origin-error="@T["PasskeyOriginMismatch", passkeyOrigin]"
              data-browser-error="@T["PasskeyBrowserUnsupported"]" data-cancelled-error="@T["PasskeyCancelled"]"
              data-duplicate-error="@T["PasskeyAlreadyRegistered"]" data-security-error="@T["PasskeySecurityError", passkeyOrigin]"
              data-session-error="@T["PasskeySessionExpired"]" data-rate-error="@T["PasskeyRateLimited"]">
            @Html.AntiForgeryToken()<button class="button secondary full" type="submit">@T["SignInPasskey"]</button><p class="validation" role="alert" data-passkey-error></p>
        </form>
        <p class="micro">@T["RecoveryNote"]</p>
    </section>
</div>
