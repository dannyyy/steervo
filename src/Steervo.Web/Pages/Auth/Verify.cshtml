@page
@model Steervo.Web.Pages.Auth.VerifyModel
@{ ViewData["Title"] = T["EnterCode"]; }
<section class="workspace-surface auth-card verification-card"><span class="access-symbol"><partial name="/Pages/Shared/_Icon.cshtml" model='"mail"' /></span><p class="eyebrow">@T["CheckInbox"]</p><h1>@T["EnterCode"]</h1><p class="muted">@T["CodeSent"]</p>
<form id="verify-form" method="post" hx-post="@Request.Path@Request.QueryString" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-request-form data-retain-on-error><input asp-for="ReturnUrl" type="hidden" /><div class="editor-error" role="alert" tabindex="-1" hidden></div><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Code">@T["OneTimeCode"]</label><input asp-for="Code" class="code-input" required pattern="[0-9]{6}" maxlength="6" inputmode="numeric" autocomplete="one-time-code" autofocus /><button type="submit" class="button primary full">@T["SignIn"] <partial name="/Pages/Shared/_Icon.cshtml" model='"arrow"' /></button></form><a class="text-link" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">@T["BackSignIn"]</a></section>
