@model Steervo.Web.Pages.Shared.FulfillmentSummary
@{
    var groups = Model.Groups;
    var summary = string.Join(", ", groups.Select(group => T["Summary" + group.State, group.Entries.Count].Value));

    // Each state takes as much of the bar as it has entries; the segments follow one another.
    var offset = 0;
}
<svg
    class="fulfillment-bar"
    viewBox="0 0 @Model.Entries.Count 1"
    preserveAspectRatio="none"
    role="img"
    aria-label="@summary">
    @foreach (var group in groups)
    {
        var state = group.State.ToString().ToLowerInvariant();

        <rect class="summary-@state" x="@offset" y="0" width="@group.Entries.Count" height="1" />

        offset += group.Entries.Count;
    }
</svg>
<ul class="fulfillment-counts">
    @foreach (var group in groups)
    {
        var state = group.State.ToString().ToLowerInvariant();
        var count = T["Summary" + group.State, group.Entries.Count];

        <li class="summary-@state" data-summary="@group.State">
            <button
                type="button"
                class="summary-chip"
                id="summary-@Model.Key-@state"
                aria-describedby="summary-list-@Model.Key-@state">@count</button>
            <div class="summary-popover" role="tooltip" id="summary-list-@Model.Key-@state">
                <strong>@count</strong>
                <ol>
                    @foreach (var entry in group.Entries)
                    {
                        var priority = entry.Criterion.Priority.ToString();

                        <li>
                            <span>@entry.Criterion.Name@if (!string.IsNullOrEmpty(entry.Value)) { <em> · @entry.Value</em> }</span>
                            <span class="summary-priority @priority.ToLowerInvariant()">@T[priority]</span>
                        </li>
                    }
                </ol>
            </div>
        </li>
    }
</ul>
