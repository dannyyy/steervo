@model Steervo.Web.Pages.Shared.AssessmentEditor
@using Steervo.Web.Pages.Shared
@{
    var criterion = Model.Criterion;
    var field = Model.FieldId;
    var draft = Model.Draft;
    var booleanChoice = Model.BooleanChoice;

    var helpKey = criterion.Type == CriterionType.Rating ? "RatingIsSubjective" : "AssessmentUnknownHelp";
    var clearLabel = T["ClearAssessmentFor", criterion.Name];

    // Without its own label the save button names the criterion and the subject for screen readers.
    var saveActions = new EditorActions(
        "save-" + field,
        Model.SubmitLabel,
        Model.SubmitLabel ?? T["SaveAssessment", criterion.Name, Model.SubjectName].Value
    );
}
<section
    id="editor-@field"
    class="inline-editor"
    data-editor
    data-opener="open-@field"
    data-assessment-subject="@Model.SubjectId"
    data-assessment-criterion="@criterion.Id"
    aria-labelledby="title-@field"
    hidden="@(draft is null)">
    <div class="editor-heading">
        <div>
            <p class="editor-context">@Model.SubjectName</p>
            <h3 id="title-@field">@criterion.Name</h3>
        </div>
        <button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]">
            <partial name="/Pages/Shared/_Icon.cshtml" model='"close"' />
        </button>
    </div>
    <p class="editor-requirement">
        @T[criterion.Priority.ToString()] · @T[criterion.Type.ToString()]
        @if (criterion.Type == CriterionType.Measurement)
        {
            <span> · @(criterion.Comparison == Comparison.AtLeast ? "≥" : "≤") @criterion.Threshold @criterion.Unit</span>
        }
    </p>
    <div class="editor-error" role="alert" tabindex="-1" hidden="@(draft is null)">@draft?.Error</div>
    <form
        method="post"
        asp-antiforgery="true"
        action="@Model.PostUrl"
        hx-post="@Model.PostUrl"
        hx-disabled-elt="find button[type='submit']"
        class="value-editor"
        data-guard-draft
        data-submitted-values="@Model.SubmittedValuesJson">
        <input type="hidden" name="version" value="@Model.Evaluation.Version" />
        <input type="hidden" name="action" value="@Model.Action" />
        <input type="hidden" name="@Model.SubjectField" value="@Model.SubjectId" />
        <input type="hidden" name="criterionId" value="@criterion.Id" />
        <div class="editor-fields">
            <div>
                <label for="value-@field">@T["AssessmentValue"]</label>
                @switch (criterion.Type)
                {
                    case CriterionType.Boolean:
                        <select
                            id="value-@field"
                            name="booleanValue"
                            aria-describedby="boolean-help-@field"
                            data-editor-focus>
                            <option value="" selected="@(string.IsNullOrEmpty(booleanChoice))">@T["FulfillmentUnknown"]</option>
                            <option value="true" selected="@(booleanChoice == "true")">@T["Yes"]</option>
                            <option value="false" selected="@(booleanChoice == "false")">@T["No"]</option>
                            <option value="optional" selected="@(booleanChoice == "optional")">@T["BooleanOptional"]</option>
                        </select>
                        <p id="boolean-help-@field" class="editor-help">@T["BooleanOptionalHelp"]</p>
                        break;
                    case CriterionType.Measurement:
                        <div class="measurement-entry">
                            <input
                                id="value-@field"
                                name="measurementValue"
                                type="number"
                                step="any"
                                value="@Model.MeasurementText"
                                placeholder="@T["FulfillmentUnknown"]"
                                aria-describedby="unit-@field"
                                data-editor-focus />
                            <span id="unit-@field">@criterion.Unit</span>
                        </div>
                        break;
                    case CriterionType.Rating:
                        <select id="value-@field" name="ratingValue" data-editor-focus>
                            <option value="" selected="@(Model.RatingValue is null)">@T["FulfillmentUnknown"]</option>
                            @for (var rating = 1; rating <= 5; rating++)
                            {
                                <option value="@rating" selected="@(Model.RatingValue == rating)">@rating / 5</option>
                            }
                        </select>
                        break;
                }
            </div>
            <div>
                <label for="source-@field">@T["AssessmentSource"]</label>
                <select id="source-@field" name="source">
                    @foreach (var source in Enum.GetValues<AssessmentSource>())
                    {
                        <option value="@source" selected="@(source == Model.Source)">@T["AssessmentSource" + source]</option>
                    }
                </select>
            </div>
        </div>
        <label for="notes-@field">@T["AssessmentNoteHelp"]</label>
        <textarea id="notes-@field" name="notes" maxlength="4000" rows="3">@Model.Notes</textarea>
        <p class="editor-help">@T[helpKey]</p>
        @if (Model.ReviewNotice is not null)
        {
            <p class="offer-review">@Model.ReviewNotice</p>
        }
        <partial name="/Pages/Shared/_EditorActions.cshtml" model="saveActions" />
    </form>
    @if (Model.HasAssessment)
    {
        <form
            method="post"
            asp-antiforgery="true"
            action="@Model.PostUrl"
            hx-post="@Model.PostUrl"
            hx-disabled-elt="find button[type=submit]"
            class="editor-reset"
            data-confirm-action="@clearLabel"
            data-confirm-description="@T["ClearAssessmentConfirm"]">
            <input type="hidden" name="version" value="@Model.Evaluation.Version" />
            <input type="hidden" name="action" value="clear-assessment" />
            <input type="hidden" name="@Model.SubjectField" value="@Model.SubjectId" />
            <input type="hidden" name="criterionId" value="@criterion.Id" />
            <button type="submit" id="clear-@field" class="text-button danger" aria-label="@clearLabel">@T["ClearAssessment"]</button>
        </form>
    }
</section>
