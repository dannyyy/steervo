@inject Steervo.Application.Accounts.IAccountAccess Accounts
@inject Steervo.Application.Evaluations.ICurrentUser Current
@{ var accountPage = Context.Request.Path.StartsWithSegments("/Account"); }
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"selfRequestsOnly":true}' />
    <title>@ViewData["Title"] · Steervo</title>
    <link rel="preload" href="~/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/canvas.css" asp-append-version="true" />
    <script src="~/lib/htmx.min.js" defer></script><script src="~/js/site.js" asp-append-version="true" defer></script><script src="~/js/sorting.js" asp-append-version="true" defer></script><script src="~/js/workspace.js" asp-append-version="true" defer></script><script src="~/js/editors.js" asp-append-version="true" defer></script><script src="~/js/specifications.js" asp-append-version="true" defer></script><script src="~/js/offers.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body data-editor-missing-error="@T["EditorMissingError"]" data-editor-operation-conflict="@T["EditorOperationConflict"]" data-editor-operation-retry="@T["EditorOperationRetry"]" data-editor-page-conflict="@T["EditorPageConflict"]" data-editor-retry="@T["EditorRetryCurrent"]" data-editor-network-error="@T["EditorNetworkError"]" data-editor-permission-error="@T["EditorPermissionError"]" data-editor-conflict="@T["EditorConflict"]" data-editor-review="@T["EditorReviewCurrent"]">
<a class="skip" href="#main">@T["Skip"]</a>
<div class="shell">
    <header class="app-header">
        <a class="brand" asp-page="/Index" aria-label="@T["SteervoHome"]"><partial name="_Icon" model='"mark"' /><span>steervo<span class="brand-dot">.</span></span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="app-navigation" aria-label="@T["Navigation"]">
                <a asp-page="/Index" aria-current="@(!accountPage ? "page" : null)"><partial name="_Icon" model='"list"' />@T["Evaluations"]</a>
                <a asp-page="/Account/Index" aria-current="@(accountPage && !Context.Request.Path.StartsWithSegments("/Account/Invitations") ? "page" : null)">@T["Account"]</a>
                @if (await Accounts.IsPrimaryAsync(Current.Id)) { <a asp-page="/Account/Invitations" aria-current="@(Context.Request.Path.StartsWithSegments("/Account/Invitations") ? "page" : null)">@T["Invitations"]</a> }
            </nav>
            <div class="app-profile"><span class="avatar" aria-hidden="true">@User.Identity.Name?[..1]</span><span class="profile-name">@User.Identity.Name</span><form method="post" asp-page="/Account/Logout"><button class="logout">@T["SignOut"]</button></form></div>
        }
        else { <span class="app-welcome">@T["PersonalWorkspace"]</span> }
    </header>
    <main id="main" tabindex="-1">@RenderBody()</main>
    <footer><span>Steervo Community · @T["SourceAvailable"]</span><span>@T["YourDecision"]</span></footer>
</div>
<div id="connection-error" role="alert" hidden>@T["ConnectionError"]</div>
<dialog id="action-confirmation" class="confirmation-dialog" aria-labelledby="confirmation-title" aria-describedby="confirmation-description" data-discard-title="@T["DiscardDraftTitle"]" data-discard-description="@T["DiscardDraftDescription"]" data-discard-action="@T["DiscardDraft"]" data-continue-action="@T["ContinueEditing"]" data-cancel-action="@T["Cancel"]">
    <h2 id="confirmation-title"></h2><p id="confirmation-description"></p>
    <div class="editor-actions"><button type="button" class="button secondary" data-confirm-cancel></button><button type="button" class="button destructive" data-confirm-accept></button></div>
</dialog>
</body>
</html>
