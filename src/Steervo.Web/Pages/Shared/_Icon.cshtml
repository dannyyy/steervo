    case "mail": <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /> break;
    case "check": <path d="m5 12 4 4L19 6" /> break;
    case "notice": <circle cx="12" cy="12" r="9" /><path d="M12 7v6m0 4h.01" /> break;
    case "mark": <path d="m7 3-5 18h6l5-18H7Zm10 0-5 18h5l5-18h-5Z" fill="currentColor" stroke="none" /> break;
    case "car": <path d="m5 7 2-4h10l2 4M3 10l2-3h14l2 3v8H3v-8Zm3 8v3m12-3v3M3 13h18M6 10h1m10 0h1" /> break;
