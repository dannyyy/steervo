    case "list": <path d="m3 6 1 1 2-2m3 1h12M3 12h3m3 0h12M3 18h3m3 0h12" /> break;
    case "plus": <path d="M12 5v14M5 12h14" /> break;
    case "close": <path d="m6 6 12 12M18 6 6 18" /> break;
    case "edit": <path d="m14 5 5 5M4 20l5-1L21 7l-5-5L4 14v6Z" /> break;
    case "arrow": <path d="M4 12h16m-6-6 6 6-6 6" /> break;
