@model Steervo.Web.Pages.Evaluations.Offers.OfferAssessmentRow
@using Steervo.Web.Pages.Shared
@{
    var criterion = Model.Criterion;
    var assessment = Model.Assessment;
    var fieldId = Model.FieldId;
}
<article
    class="assessment-row"
    id="@fieldId"
    data-offer-assessment="@criterion.Id"
    data-result="@Model.Result"
    data-stale="@Model.Stale.ToString().ToLowerInvariant()">
    @if (Model.CanEdit)
    {
        <button
            type="button"
            class="assessment-summary"
            id="open-@fieldId"
            data-editor-open="editor-@fieldId"
            aria-expanded="@Model.HasDraft.ToString().ToLowerInvariant()"
            aria-controls="editor-@fieldId"
            aria-label="@T["EditAssessmentFor", criterion.Name, Model.Offer.Latest.Terms.Name]">
            <partial name="_OfferAssessmentSummary" model="Model" />
        </button>
    }
    else
    {
        <div class="assessment-summary">
            <partial name="_OfferAssessmentSummary" model="Model" />
        </div>
    }
    @if (Model.Stale)
    {
        <p class="offer-review">@T["OfferAssessmentStale", assessment!.RevisionNumber]</p>
    }
    @if (!string.IsNullOrEmpty(assessment?.Notes))
    {
        <p class="assessment-notes-text">@assessment.Notes</p>
    }
    @if (Model.CanEdit)
    {
        <partial name="/Pages/Shared/_AssessmentEditor.cshtml" model="Model.Editor(T)" />
    }
</article>
