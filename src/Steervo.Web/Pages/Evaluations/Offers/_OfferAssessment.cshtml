@model Steervo.Web.Pages.Evaluations.Offers.OfferAssessmentRow
@using Steervo.Web.Pages.Shared
@{ var c = Model.Criterion; var a = Model.Assessment; var field = Model.FieldId; var edit = Model.Access >= AccessLevel.Editor && !Model.Offer.Archived; }
<article class="assessment-row" id="@field" data-offer-assessment="@c.Id" data-result="@Model.Result" data-stale="@Model.Stale.ToString().ToLowerInvariant()">
@if (edit)
{
    <button type="button" class="assessment-summary" id="open-@field" data-editor-open="editor-@field" aria-expanded="@Model.HasDraft.ToString().ToLowerInvariant()" aria-controls="editor-@field" aria-label="@T["EditAssessmentFor", c.Name, Model.Offer.Latest.Terms.Name]"><partial name="_OfferAssessmentSummary" model="Model" /></button>
}
else { <div class="assessment-summary"><partial name="_OfferAssessmentSummary" model="Model" /></div> }
@if (Model.Stale) { <p class="offer-review">@T["OfferAssessmentStale", a!.RevisionNumber]</p> }
@if (!string.IsNullOrEmpty(a?.Notes)) { <p class="assessment-notes-text">@a.Notes</p> }
@if (edit)
{
    <partial name="/Pages/Shared/_AssessmentEditor.cshtml" model='new AssessmentEditor(Model.Evaluation, c, Model.Offer.Id, Model.Offer.Latest.Terms.Name, "offerId", "assess-offer", field, Model.PostUrl) { BooleanValue = a?.BooleanValue, OptionalAvailable = a?.OptionalAvailable ?? false, MeasurementValue = a?.MeasurementValue, RatingValue = a?.RatingValue, Source = a?.Source ?? AssessmentSource.Unknown, Notes = a?.Notes, HasAssessment = a is not null, Draft = Model.HasDraft ? Model.Draft : null, ReviewNotice = Model.Stale ? T["OfferAssessmentStale", a!.RevisionNumber].Value : null, SubmitLabel = Model.Stale ? T["OfferAssessmentReview"].Value : null }' />
}
</article>
