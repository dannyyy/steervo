@model Steervo.Web.Pages.Evaluations.Offers.OfferAssessmentRow
@{
    var criterion = Model.Criterion;
    var linkedLine = Model.LinkedLine;
    var source = Model.Assessment?.Source ?? AssessmentSource.Unknown;
}
<span class="assessment-label">
    <strong>@criterion.Name</strong>
    <span class="assessment-requirement">
        @T[criterion.Priority.ToString()] · @T[criterion.Type.ToString()]
        @if (criterion.Type == CriterionType.Measurement)
        {
            <span> · @(criterion.Comparison == Comparison.AtLeast ? "≥" : "≤") @criterion.Threshold @criterion.Unit</span>
        }
    </span>
</span>
<span class="assessment-answer">
    <strong>@Model.AnswerText(T)</strong>
    <span data-linked-line="@(linkedLine is not null)">@(linkedLine is not null ? T["OfferLineFulfils", linkedLine.Name].Value : T["AssessmentSource" + source].Value)</span>
</span>
<span class="fulfillment @Model.ResultClass">@T["Fulfillment" + Model.Result]</span>
@if (Model.CanEdit)
{
    <span class="assessment-edit-icon">
        <partial name="/Pages/Shared/_Icon.cshtml" model='"edit"' />
    </span>
}
