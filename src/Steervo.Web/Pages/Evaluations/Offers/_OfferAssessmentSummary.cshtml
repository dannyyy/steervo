@model Steervo.Web.Pages.Evaluations.Offers.OfferAssessmentRow
@{ var c = Model.Criterion; var a = Model.Assessment; var linked = Model.LinkedLine; }
<span class="assessment-label"><strong>@c.Name</strong><span class="assessment-requirement">@T[c.Priority.ToString()] · @T[c.Type.ToString()] @if (c.Type == CriterionType.Measurement) { <span> · @(c.Comparison == Comparison.AtLeast ? "≥" : "≤") @c.Threshold @c.Unit</span> }</span></span>
<span class="assessment-answer"><strong>@(linked is not null ? T["Yes"].Value : c.Type == CriterionType.Boolean ? T[a?.OptionalAvailable == true ? "BooleanOptional" : a?.BooleanValue is { } boolean ? boolean ? "Yes" : "No" : "FulfillmentUnknown"].Value : c.Type == CriterionType.Rating ? a?.RatingValue is { } rating ? $"{rating} / 5" : T["FulfillmentUnknown"].Value : a?.MeasurementValue is { } value ? $"{value:G} {c.Unit}" : T["FulfillmentUnknown"].Value)</strong><span data-linked-line="@(linked is not null)">@(linked is not null ? T["OfferLineFulfils", linked.Name].Value : T["AssessmentSource" + (a?.Source ?? AssessmentSource.Unknown)].Value)</span></span>
<span class="fulfillment @Model.Result.ToString().ToLowerInvariant()">@T["Fulfillment" + Model.Result]</span>
@if (Model.Access >= AccessLevel.Editor) { <span class="assessment-edit-icon"><partial name="/Pages/Shared/_Icon.cshtml" model='"edit"' /></span> }
