@model Steervo.Web.Pages.Evaluations.Offers.OfferAssessmentRow
@{ var c = Model.Criterion; var a = Model.Assessment; }
<span class="assessment-label"><strong>@c.Name</strong><span class="assessment-requirement">@T[c.Priority.ToString()] · @T[c.Type.ToString()] @if (c.Type == CriterionType.Measurement) { <span> · @(c.Comparison == Comparison.AtLeast ? "≥" : "≤") @c.Threshold @c.Unit</span> }</span></span>
<span class="assessment-answer"><strong>@(c.Type == CriterionType.Boolean ? T[a?.BooleanValue is { } boolean ? boolean ? "Yes" : "No" : "FulfillmentUnknown"].Value : c.Type == CriterionType.Rating ? a?.RatingValue is { } rating ? $"{rating} / 5" : T["FulfillmentUnknown"].Value : a?.MeasurementValue is { } value ? $"{value:G} {c.Unit}" : T["FulfillmentUnknown"].Value)</strong><span>@T["AssessmentSource" + (a?.Source ?? AssessmentSource.Unknown)]</span></span>
<span class="fulfillment @Model.Result.ToString().ToLowerInvariant()">@T["Fulfillment" + Model.Result]</span>
@if (Model.Access >= AccessLevel.Editor && !Model.Offer.Archived) { <span class="assessment-edit-icon"><partial name="/Pages/Shared/_Icon.cshtml" model='"edit"' /></span> }
