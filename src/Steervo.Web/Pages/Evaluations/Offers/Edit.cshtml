@page "/evaluations/{id:guid}/offers/edit/{offerId:guid?}"
@model Steervo.Web.Pages.Evaluations.Offers.EditModel
@using Steervo.Web.Pages.Evaluations.Offers
@{
    ViewData["Title"] = T[Model.TitleKey];

    var evaluation = Model.Evaluation;
}
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(evaluation, Model.Access, "offers")' />
<a class="back-link" href="@Model.ReturnUrl"><partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T[Model.IsNew ? "AllOffers" : "Offer"]</a>
<section
    id="offer-page-editor"
    class="workspace-surface page-editor"
    data-editor
    data-page-editor
    data-return-url="@Model.ReturnUrl"
    aria-labelledby="offer-editor-title">
    <div class="surface-heading">
        <div>
            <p class="editor-context">@Model.EditorContext</p>
            <h2 id="offer-editor-title">@T[Model.TitleKey]</h2>
            <p class="muted">@T["OfferUnknownHelp"]</p>
        </div>
    </div>
    @if (Model.Offer is not null)
    {
        <p class="notice">@T["OfferVersion", Model.Offer.Latest.Number] · @T["OfferHistoryHelp"]</p>
    }
    <div class="editor-error notice failure" role="alert" tabindex="-1" hidden="@(Model.Notice is null)">@Model.Notice</div>
    <form
        method="post"
        enctype="multipart/form-data"
        hx-encoding="multipart/form-data"
        class="offer-form"
        data-offer-form
        data-guard-draft
        data-retain-on-error
        hx-post="@Request.Path@Request.QueryString"
        hx-swap="none"
        hx-sync="this:drop"
        hx-disabled-elt="find button[type=submit]">
        <input type="hidden" asp-for="Version" />
        <section class="form-section">
            <div class="field-pair">
                <div>
                    <label for="offer-candidate">@T["OfferCandidate"]</label>
                    @if (Model.Offer is null)
                    {
                        <select id="offer-candidate" name="Input.CandidateId" required data-offer-candidate>
                            <option value="">@T["SelectCandidate"]</option>
                            @foreach (var candidate in Model.OrderedCandidates)
                            {
                                <option value="@candidate.Id" selected="@(candidate.Id == Model.Input.CandidateId)" data-description="@candidate.DisplayName">@candidate.DisplayName</option>
                            }
                        </select>
                    }
                    else
                    {
                        <p>@evaluation.FindCandidate(Model.Offer.CandidateId).DisplayName</p>
                    }
                </div>
                <div>
                    <label for="offer-currency">@T["OfferCurrency"]</label>
                    <input
                        id="offer-currency"
                        name="Input.Currency"
                        value="@(evaluation.Currency ?? Model.Input.Currency)"
                        readonly
                        required
                        minlength="3"
                        maxlength="3"
                        pattern="[A-Za-z]{3}"
                        autocomplete="off"
                        aria-describedby="offer-currency-help" />
                    <p class="micro" id="offer-currency-help">@T["OfferCurrencyHelp"] <a asp-page="/Evaluations/Details" asp-route-id="@evaluation.Id" asp-route-section="settings">@T["CaseSettings"]</a></p>
                </div>
            </div>
        </section>
        <section class="form-section">
            <h3>@T["OfferAttachmentTitle"] <span class="optional">@T["OptionalField"]</span></h3>
            <p class="micro" id="offer-upload-help">@T["OfferAttachmentHelp"]</p>
            <label for="offer-upload">@T["OfferAttachmentFile"]</label>
            <input id="offer-upload" name="upload" type="file" accept="application/pdf,.pdf" aria-describedby="offer-upload-help" />
        </section>
        @foreach (var group in OfferFields.All.GroupBy(field => field.Group))
        {
            <section class="form-section">
                <h3>@T["OfferGroup" + group.Key]</h3>
                @if (group.Key == OfferFields.PriceGroup)
                {
                    <div data-offer-lines>
                        @foreach (var lineEditor in Model.LineEditors)
                        {
                            <partial name="_OfferLineEditor" model="lineEditor" />
                        }
                    </div>
                    <template data-offer-line-template>
                        <partial name="_OfferLineEditor" model="Model.LineTemplate" />
                    </template>
                    <button type="button" class="button secondary" data-offer-line-add>
                        <partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />@T["AddOfferLine"]
                    </button>
                    <dl
                        class="offer-totals"
                        data-offer-totals
                        data-label-leasing="@T["OfferLineFinanced"]"
                        data-label-financing="@T["OfferLineFinancedLoan"]"
                        aria-live="polite">
                        <div class="offer-total">
                            <dt>@T["OfferPriceTotal"]</dt>
                            <dd data-total="total"></dd>
                        </div>
                        <div data-total-contract>
                            <dt data-financed-label>@T["OfferPriceFinanced"]</dt>
                            <dd data-total="financed"></dd>
                        </div>
                        <div data-total-contract>
                            <dt>@T["OfferPriceDueAtHandover"]</dt>
                            <dd data-total="handover"></dd>
                        </div>
                        <div data-total-concession>
                            <dt>@T["OfferPriceConcession"]</dt>
                            <dd data-total="concession"></dd>
                        </div>
                    </dl>
                }
                @if (group.Key == OfferFields.ContractGroup)
                {
                    <p class="micro">@T["OfferContractHelp"]</p>
                }
                @if (group.Key == OfferFields.MileageGroup)
                {
                    <p class="micro">@T["OfferMileageHelp"]</p>
                }
                @if (group.Key == OfferFields.PriceGroup)
                {
                    <p class="micro">@T["OfferStatedTotalHelp"]</p>
                }
                <div class="offer-fields">
                    @if (group.Key == OfferFields.HeaderGroup)
                    {
                        <div>
                            <label for="offer-kind">@T["OfferKind"]</label>
                            <select id="offer-kind" name="Input.Kind">
                                @foreach (var kind in Enum.GetValues<OfferKind>())
                                {
                                    <option value="@kind" selected="@(kind == Model.Input.Kind)">@T["OfferKind" + kind]</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label for="offer-commitment">@T["OfferCommitment"]</label>
                            <select id="offer-commitment" name="Input.Commitment">
                                @foreach (var commitment in Enum.GetValues<OfferCommitment>())
                                {
                                    <option value="@commitment" selected="@(commitment == Model.Input.Commitment)">@T["OfferCommitment" + commitment]</option>
                                }
                            </select>
                        </div>
                    }
                    @foreach (var field in group)
                    {
                        <div class="@(field.IsTextArea ? "offer-wide" : null)">
                            <label for="offer-@field.Name">
                                @T[field.Label]
                                @if (field.IsMoney)
                                {
                                    <span class="field-unit" data-offer-currency-label>@Model.Input.Currency</span>
                                    @if (field.IsUnitPrice)
                                    {
                                        <span class="field-unit">@T["OfferKilometreUnit"]</span>
                                    }
                                }
                            </label>
                            @if (field.IsTextArea)
                            {
                                <textarea id="offer-@field.Name" name="Input.@field.Name" maxlength="@field.MaxLength" rows="3">@Model.Input.Value(field.Name)</textarea>
                            }
                            else
                            {
                                <input
                                    id="offer-@field.Name"
                                    name="Input.@field.Name"
                                    value="@Model.Input.Value(field.Name)"
                                    type="@field.InputType"
                                    required="@field.IsRequired"
                                    maxlength="@field.InputMaxLength"
                                    step="@field.InputStep"
                                    min="@field.InputMinimum" />
                            }
                        </div>
                    }
                </div>
            </section>
        }
        <section class="form-section">
            <label for="offer-change-note">@T["OfferChangeNote"] <span class="optional">@T["OptionalField"]</span></label>
            <textarea id="offer-change-note" name="Input.ChangeNote" maxlength="2000" rows="2">@Model.Input.ChangeNote</textarea>
        </section>
        <partial name="/Pages/Shared/_PageEditorActions.cshtml" model='new Steervo.Web.Pages.Shared.PageEditorActions(Model.ReturnUrl, "save-offer", T[Model.IsNew ? "OfferSaveNew" : "OfferSaveRevision"].Value)' />
    </form>
</section>
