@page "/evaluations/{id:guid}/offers"
@model Steervo.Web.Pages.Evaluations.Offers.IndexModel
@using Steervo.Web.Pages.Shared
@using Steervo.Web.Pages.Evaluations.Candidates
@using Steervo.Web.Pages.Evaluations.Offers
@{ ViewData["Title"] = T["Offers"]; var e = Model.Evaluation; var edit = Model.Access >= AccessLevel.Editor; var offers = Model.Offers.ToList(); var criteria = e.Criteria.Where(criterion => criterion.Scope == CriterionScope.Offer).OrderBy(criterion => criterion.Position).ToList(); }
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(e, Model.Access, "offers")' />
<div class="surface-heading offer-heading"><div><h2>@T["Offers"]</h2></div><div class="surface-actions">@if (offers.Count > 1) { <form id="compare-selection" method="get" action="/evaluations/@e.Id/offers/compare" data-compare-form data-compare-maximum="@ComparisonSelection.Maximum"><button class="button secondary" id="compare-selected" data-compare-label="@T["CompareCandidates"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"compare"' /><span>@T["CompareCandidates"] (0/@ComparisonSelection.Maximum)</span></button></form> }@if (edit && e.Candidates.Count > 0) { <a asp-page="Edit" asp-route-id="@e.Id" asp-route-candidateId="@Model.CandidateId" class="button primary"><partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />@T["NewOffer"]</a> }</div></div>
@if (e.Candidates.Count == 0) { <p class="notice">@T["OffersNeedCandidate"] <a asp-page="/Evaluations/Candidates/Index" asp-route-id="@e.Id">@T["Candidates"] →</a></p> }
else
{
<section class="workspace-surface offer-collection">
<form method="get" class="offer-filter"><div><label for="offer-candidate-filter">@T["OfferCandidate"]</label><select id="offer-candidate-filter" name="candidateId"><option value="">@T["AllCandidates"]</option>@foreach (var candidate in e.Candidates.OrderBy(candidate => candidate.Position)) { <option value="@candidate.Id" selected="@(candidate.Id == Model.CandidateId)">@candidate.DisplayName</option> }</select></div><label class="offer-checkbox"><input type="checkbox" name="showArchived" value="true" checked="@Model.ShowArchived" />@T["ShowArchivedOffers"]</label><button class="button secondary">@T["ApplyOfferFilter"]</button></form>
@if (offers.Count == 0) { <div class="canvas-empty"><h3>@T["NoOffers"]</h3>@if (Model.CandidateId.HasValue || Model.ShowArchived) { <a class="text-link" asp-page="Index" asp-route-id="@e.Id">@T["OfferAllFilters"]</a> }</div> }
<div class="offer-list">
@foreach (var offer in offers)
{
    var revision = offer.Latest; var candidate = e.FindCandidate(offer.CandidateId); var missing = revision.Terms.MissingFields().ToArray();
    var entries = criteria.Select(criterion => { var row = new OfferAssessmentRow(e, offer, criterion, Model.Access); return new FulfillmentEntry(criterion, row.Result, row.Result == Fulfillment.Rated && row.Assessment?.RatingValue is { } rating ? $"{rating} / 5" : null); }).ToList();
    var failures = entries.Where(entry => entry.Criterion.Priority == Priority.Required && entry.Result == Fulfillment.Unmet).Select(entry => entry.Criterion.Name).ToList();
    <article class="offer-card" data-offer-id="@offer.Id">
    <div class="offer-card-heading"><p class="eyebrow">@candidate.DisplayName</p><h3><a asp-page="Details" asp-route-id="@e.Id" asp-route-offerId="@offer.Id">@revision.Terms.Name</a></h3><div class="offer-badges"><span class="badge">@T["OfferKind" + revision.Terms.Kind]</span><span class="badge">@T["OfferCommitment" + revision.Terms.Commitment]</span><span class="badge">@T["OfferVersion", revision.Number]</span>@if (offer.Archived) { <span class="badge">@T["OfferArchivedLabel"]</span> }</div>@if (!string.IsNullOrEmpty(revision.Terms.Provider)) { <p class="offer-card-provider">@revision.Terms.Provider</p> }</div>
    <div class="offer-card-summary"><dl class="offer-card-prices"><div><dt>@T["OfferBasePrice"]</dt><dd class="@(revision.Terms.BasePrice.HasValue ? null : "offer-open")">@(revision.Terms.BasePrice.HasValue ? $"{revision.Terms.BasePrice:N2} {e.Currency}" : T["OfferOpen"].Value)</dd></div>@if (revision.Terms.Kind is OfferKind.Leasing or OfferKind.Financing) { <div><dt>@T["OfferMonthlyPayment"]</dt><dd class="@(revision.Terms.MonthlyPayment.HasValue ? null : "offer-open")">@(revision.Terms.MonthlyPayment.HasValue ? $"{revision.Terms.MonthlyPayment:N2} {e.Currency}" : T["OfferOpen"].Value)</dd></div> }</dl>
    @if (entries.Count > 0) { <partial name="/Pages/Shared/_FulfillmentSummary.cshtml" model="new FulfillmentSummary(offer.Id.ToString(), entries)" /> }
    @if (failures.Count > 0) { <p class="candidate-warning"><strong>@T["RequiredNotMet"]:</strong> @string.Join(" · ", failures)</p> }
    @if (missing.Length > 0) { <p class="offer-gaps"><strong>@T["OfferOpenFields"]:</strong> @string.Join(" · ", missing.Select(field => T["Offer" + field].Value))</p> }
    </div>
    <div class="candidate-side">@if (offers.Count > 1) { <label class="candidate-compare" for="compare-@offer.Id"><input type="checkbox" id="compare-@offer.Id" form="compare-selection" name="more" value="@offer.Id" data-compare-select /><span>@T["CompareCandidates"]</span></label> }</div>
    </article>
}
</div></section>
}
