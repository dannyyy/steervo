@model Steervo.Web.Pages.Evaluations.Offers.OfferSnapshot
@using Steervo.Web.Pages.Evaluations.Offers
@{
    var terms = Model.Revision.Terms;
}
<div class="offer-value-groups" id="offer-facts">
    @foreach (var group in OfferFields.DetailGroups)
    {
        if (!Model.ShowsValueGroup(group.Key))
        {
            continue;
        }

        <section>
            <h3>@T["OfferGroup" + group.Key]</h3>
            <dl class="offer-values">
                @foreach (var field in group)
                {
                    var hasValue = !string.IsNullOrEmpty(field.Display(terms));

                    <div data-offer-field="@field.Name" class="@(field.IsText ? "offer-text-value" : null)">
                        <dt>@T[field.Label]</dt>
                        @* The value keeps its line breaks (pre-wrap), so the content of the cell stays on one line. *@
                        <dd class="@(hasValue ? null : "muted")">@field.DisplayOrOpen(terms, T) @if (hasValue && field.IsMoney) { <span>@Model.Currency</span> @if (field.IsUnitPrice) { <span>@T["OfferKilometreUnit"]</span> } }</dd>
                    </div>
                }
            </dl>
        </section>
    }
</div>
