@model Steervo.Web.Pages.Evaluations.Offers.OfferSnapshot
@using Steervo.Web.Pages.Evaluations.Offers
@if (Model.Revision.Lines.Count == 0)
{
    <p class="muted">@T["OfferNoLines"]</p>
}
else
{
    <ul class="offer-lines">
        @foreach (var line in Model.OrderedLines)
        {
            var criterion = Model.CriterionOf(line);

            <li data-offer-line-kind="@line.Kind" data-offer-line-price="@line.PriceKind">
                <div><span class="micro">@T["OfferLineKind" + line.Kind]</span><strong>@line.Name</strong><span class="offer-line-price">@Model.LinePrice(line, T)</span></div>
                @if (line.Value.HasValue)
                {
                    <p class="micro">@T["OfferLineValueOf", $"{line.Value:N2} {Model.Currency}"]</p>
                }
                @if (Model.IsDueAtHandover(line))
                {
                    <p class="micro" data-offer-line-handover>@T["OfferLineAtHandover"]</p>
                }
                @if (OfferSnapshot.HasBenefitDetails(line))
                {
                    <p class="micro">
                        @(line.Effect.HasValue ? T["OfferBenefitEffect" + line.Effect].Value : T["OfferOpen"].Value)
                        @if (line.CostCategory.HasValue)
                        {
                            <span> · @T["CostCategory" + line.CostCategory]</span>
                        }
                        · @(line.DurationMonths.HasValue ? T["OfferDuration", line.DurationMonths.Value].Value : T["OfferDurationOpen"].Value)
                    </p>
                }
                @if (criterion is not null)
                {
                    <p class="micro offer-line-criterion">@T["OfferLineFulfils", criterion.Name]</p>
                }
                @if (line.Notes.Length > 0)
                {
                    <p class="offer-note">@line.Notes</p>
                }
            </li>
        }
    </ul>
}
