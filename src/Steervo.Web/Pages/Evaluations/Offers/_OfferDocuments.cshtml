@model Steervo.Web.Pages.Evaluations.Offers.DetailsModel
@using Steervo.Web.Pages.Evaluations.Offers
@{
    var evaluation = Model.Evaluation;
    var offer = Model.Offer;
    var canChange = Model.CanChange;
    var documents = Model.Documents;
}
<section class="record-section offer-documents" id="documents">
    <div class="section-heading">
        <div>
            <h3 id="documents-title" tabindex="-1">@T["Documents"]</h3>
            <p class="micro">@T["DocumentsHelp"]</p>
        </div>
        @if (canChange)
        {
            <a
                class="button secondary"
                asp-page="Upload"
                asp-route-first="@Model.First"
                asp-route-second="@Model.Second"
                asp-route-id="@evaluation.Id"
                asp-route-offerId="@offer.Id">@T["DocumentAdd"]</a>
        }
    </div>
    @if (documents.Count == 0)
    {
        <p class="muted">@T["DocumentsEmpty"]</p>
    }
    @foreach (var document in documents)
    {
        var history = Model.HistoryOf(document);
        var latest = history[0];

        <article id="document-@document.Id" class="document-row" data-document-id="@document.Id">
            <div class="document-heading">
                <div>
                    <h4>@document.Name</h4>
                    <p class="micro">@latest.File.FileName · @DetailsModel.FormatKibibytes(latest.File.Length) KiB · @T["DocumentVersion", latest.Number]</p>
                </div>
                <div class="document-actions">
                    <a
                        class="button secondary"
                        download
                        asp-page="/Evaluations/Document"
                        asp-route-id="@evaluation.Id"
                        asp-route-documentId="@document.Id"
                        asp-route-number="@latest.Number">@T["DocumentDownload"]</a>
                    @if (canChange)
                    {
                        <a
                            asp-page="Upload"
                            asp-route-first="@Model.First"
                            asp-route-second="@Model.Second"
                            asp-route-id="@evaluation.Id"
                            asp-route-offerId="@offer.Id"
                            asp-route-documentId="@document.Id">@T["DocumentReplace"]</a>
                    }
                </div>
            </div>
            <details id="document-history-@document.Id">
                <summary>@T["DocumentHistory", history.Count]</summary>
                <ol class="document-history">
                    @foreach (var item in history)
                    {
                        <li data-document-version="@item.Number">
                            <div>
                                <a download asp-page="/Evaluations/Document" asp-route-id="@evaluation.Id" asp-route-documentId="@document.Id" asp-route-number="@item.Number">@T["DocumentVersion", item.Number] · @item.File.FileName</a><span class="micro">@T["OfferVersion", item.OfferRevisionNumber] · <time datetime="@item.CreatedAt.ToString("O")">@DetailsModel.FormatTimestamp(item.CreatedAt)</time></span>
                            </div>
                            @if (item.Note.Length > 0)
                            {
                                <p>@item.Note</p>
                            }
                        </li>
                    }
                </ol>
            </details>
            @if (canChange)
            {
                <form
                    method="post"
                    hx-post="/evaluations/@evaluation.Id/offers/@offer.Id@Model.ReturnContext"
                    data-confirm-action="@T["DocumentDeleteNamed", document.Name]"
                    data-confirm-description="@T["DocumentDeleteConfirm"]"
                    data-focus-fallback="documents-title"
                    class="document-delete">
                    <input type="hidden" name="version" value="@evaluation.Version" />
                    <input type="hidden" name="action" value="remove-document" />
                    <input type="hidden" name="documentId" value="@document.Id" />
                    <button type="submit" class="text-button danger">@T["DocumentDelete"]</button>
                </form>
            }
        </article>
    }
</section>
