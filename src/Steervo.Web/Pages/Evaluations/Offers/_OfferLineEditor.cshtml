@model Steervo.Web.Pages.Evaluations.Offers.OfferLineEditor
@{ var line = Model.Line; var key = Model.Key; var prefix = $"Input.Lines[{key}]"; }
<fieldset class="offer-line-editor" data-offer-line><legend>@T["OfferLineName"]</legend><input type="hidden" name="Input.Lines.Index" value="@key" /><div class="offer-line-actions"><button type="button" aria-label="@T["MoveOfferLineUp"]" data-offer-line-up><partial name="/Pages/Shared/_Icon.cshtml" model='"up"' /></button><button type="button" aria-label="@T["MoveOfferLineDown"]" data-offer-line-down><partial name="/Pages/Shared/_Icon.cshtml" model='"down"' /></button><button type="button" data-offer-line-remove>@T["RemoveOfferLine"]</button></div><div class="offer-fields">
<div class="offer-wide"><label for="line-@key-name">@T["OfferLineName"]</label><input id="line-@key-name" name="@(prefix).Name" value="@line.Name" maxlength="300" required /></div>
<div><label for="line-@key-kind">@T["OfferLineKind"]</label><select id="line-@key-kind" name="@(prefix).Kind" data-line-kind>@foreach (var kind in Enum.GetValues<OfferLineKind>()) { <option value="@kind" selected="@(kind == line.Kind)">@T["OfferLineKind" + kind]</option> }</select></div>
<div><label for="line-@key-price">@T["OfferLinePriceKind"]</label><select id="line-@key-price" name="@(prefix).PriceKind" data-line-price>@foreach (var kind in Enum.GetValues<OfferPriceKind>()) { <option value="@kind" selected="@(kind == line.PriceKind)">@T["OfferPriceKind" + kind]</option> }</select></div>
<div data-line-amount><label for="line-@key-amount">@T["OfferLineAmount"] <span class="field-unit" data-offer-currency-label></span></label><input id="line-@key-amount" name="@(prefix).Amount" value="@line.Amount" type="number" min="0" step="any" /></div>
<div data-line-benefit><label for="line-@key-effect">@T["OfferLineEffect"]</label><select id="line-@key-effect" name="@(prefix).Effect" data-line-effect><option value="">@T["OfferOpen"]</option>@foreach (var effect in Enum.GetValues<OfferBenefitEffect>()) { <option value="@effect" selected="@(effect == line.Effect)">@T["OfferBenefitEffect" + effect]</option> }</select></div>
<div data-line-category><label for="line-@key-category">@T["OfferLineCostCategory"]</label><select id="line-@key-category" name="@(prefix).CostCategory"><option value="">@T["OfferOpen"]</option>@foreach (var category in Enum.GetValues<CostCategory>()) { <option value="@category" selected="@(category == line.CostCategory)">@T["CostCategory" + category]</option> }</select></div>
<div data-line-benefit><label for="line-@key-duration">@T["OfferLineDurationMonths"]</label><input id="line-@key-duration" name="@(prefix).DurationMonths" value="@line.DurationMonths" type="number" min="1" max="1200" step="1" /></div>
<div class="offer-wide"><label for="line-@key-notes">@T["OfferLineNotes"]</label><textarea id="line-@key-notes" name="@(prefix).Notes" maxlength="2000" rows="2">@line.Notes</textarea></div>
</div></fieldset>
