@page "/evaluations/{id:guid}/offers/compare"
@model Steervo.Web.Pages.Evaluations.Offers.CompareModel
@using Steervo.Web.Pages.Evaluations.Offers
@using Steervo.Web.Pages.Evaluations.Candidates
@{
    ViewData["Title"] = T["OfferCompare"];

    var evaluation = Model.Evaluation;
    var selected = Model.Selected;
    var available = Model.Available;
    var columnCount = selected.Count + 1;
}
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(evaluation, Model.Access, "offers")' />
<a asp-page="Index" asp-route-id="@evaluation.Id" class="back-link"><partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T["AllOffers"]</a>
<section class="comparison-surface car-comparison">
    @if (selected.Count == 0)
    {
        <div class="candidate-empty">
            <div>
                <h3>@T["NoOffers"]</h3>
            </div>
        </div>
    }
    else
    {
        <div class="comparison-toolbar">
            <h2 id="offer-comparison-title">@T["OfferCompare"]</h2>
            @if (selected.Count >= ComparisonSelection.Maximum)
            {
                <p class="comparison-limit">@T["OfferComparisonFull", ComparisonSelection.Maximum]</p>
            }
            else if (available.Count > 0)
            {
                <form method="get" class="comparison-add">
                    <input type="hidden" name="first" value="@Model.First?.Id" />
                    <input type="hidden" name="second" value="@Model.Second?.Id" />
                    @foreach (var id in Model.More)
                    {
                        <input type="hidden" name="more" value="@id" />
                    }
                    <label for="compare-add" class="visually-hidden">@T["OfferComparisonAddLabel"]</label>
                    <select id="compare-add" name="more">
                        @foreach (var offer in available)
                        {
                            <option value="@offer.Id">@Model.OfferLabel(offer)</option>
                        }
                    </select>
                    <button class="button secondary" id="compare-add-submit">
                        <partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />@T["OfferComparisonAdd"]
                    </button>
                </form>
            }
        </div>
        @if (Model.Limited)
        {
            <p class="notice" data-comparison-limited>@T["OfferComparisonLimited", ComparisonSelection.Maximum]</p>
        }
        @if (selected.Count == 1 && available.Count > 0)
        {
            <p class="notice">@T["OfferCompareNeedTwo"]</p>
        }
        <p class="comparison-scroll-hint" id="offer-scroll-hint">@T["ComparisonScrollHint"]</p>
        <div
            id="offer-comparison-scroll"
            class="comparison-scroll"
            tabindex="0"
            role="region"
            aria-label="@T["OfferComparisonRegion"]"
            aria-describedby="offer-scroll-hint"
            data-focus-offer="@Request.Query["focus"]">
            <table class="vehicle-table offer-table cars-@selected.Count @(selected.Count == 1 ? "vehicle-table-single" : null)">
                <caption class="visually-hidden">@T["OfferCompare"] · @evaluation.Currency</caption>
                <colgroup>
                    <col class="criterion-column" />
                    @foreach (var offer in selected)
                    {
                        <col />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">@T["ComparisonRowLabel"]</span>@evaluation.Currency</th>
                        @foreach (var offer in selected)
                        {
                            var offerName = offer.Latest.Terms.Name;

                            <th scope="col" data-offer-column="@offer.Id">
                                <p class="comparison-context">@Model.CandidateName(offer)</p>
                                <div class="comparison-car">
                                    <a href="/evaluations/@evaluation.Id/offers/@offer.Id?@Model.Query" class="comparison-candidate-link">@offerName</a>
                                    @if (selected.Count > 1)
                                    {
                                        <a
                                            class="icon-button comparison-remove"
                                            href="/evaluations/@evaluation.Id/offers/compare?@Model.QueryWithout(offer)"
                                            aria-label="@T["ComparisonRemove", offerName]"
                                            title="@T["ComparisonRemove", offerName]">
                                            <partial name="/Pages/Shared/_Icon.cshtml" model='"close"' />
                                        </a>
                                    }
                                </div>
                                <div class="offer-badges">
                                    <span class="badge">@T["OfferVersion", offer.Latest.Number]</span>
                                </div>
                                <p class="micro">@T["OfferKind" + offer.Latest.Terms.Kind] · @T["OfferCommitment" + offer.Latest.Terms.Commitment]</p>
                            </th>
                        }
                    </tr>
                </thead>
                @foreach (var group in OfferFields.DetailGroups)
                {
                    if (!Model.ShowsGroup(group.Key))
                    {
                        continue;
                    }

                    <tbody>
                        <tr class="vehicle-group-heading">
                            <th colspan="@columnCount" scope="colgroup">
                                <span class="comparison-group-label">@T["OfferGroup" + group.Key]</span>
                            </th>
                        </tr>
                        @if (group.Key == OfferFields.PriceGroup)
                        {
                            foreach (var key in OfferPrices.Keys)
                            {
                                if (!Model.ShowsPriceRow(key))
                                {
                                    continue;
                                }

                                <tr data-offer-comparison-price="@key" class="@(key == OfferPrices.Total ? "offer-total-row" : null)">
                                    <th scope="row" class="vehicle-criterion">@T[Model.PriceLabel(key)] <span class="field-unit">@evaluation.Currency</span></th>
                                    @foreach (var offer in selected)
                                    {
                                        var amount = OfferPrices.Value(offer.Latest, key);

                                        @* The cell keeps its line breaks (pre-wrap), so its content stays on one line. *@
                                        <td class="vehicle-value offer-note" data-offer-cell="@offer.Id">@(Model.PriceText(key, amount, T))@if (Model.ConcessionPercent(offer, key, amount) is { } percent) { <span class="offer-percent"> · @percent.ToString("0.#") %</span> }</td>
                                    }
                                </tr>
                            }
                        }
                        @if (group.Key == OfferFields.PriceGroup)
                        {
                            <tr data-offer-comparison-lines>
                                <th scope="row" class="vehicle-criterion">@T["OfferLinesRow"]</th>
                                @foreach (var offer in selected)
                                {
                                    <td class="vehicle-value">
                                        <partial name="_OfferLines" model="new OfferSnapshot(offer.Latest, evaluation.Currency, evaluation.Criteria)" />
                                    </td>
                                }
                            </tr>
                        }
                        @foreach (var field in group)
                        {
                            <tr data-offer-comparison-field="@field.Name">
                                <th scope="row" class="vehicle-criterion">
                                    @T[field.Label]
                                    @if (field.IsMoney)
                                    {
                                        <span class="field-unit">@evaluation.Currency</span>
                                    }
                                </th>
                                @foreach (var offer in selected)
                                {
                                    <td class="vehicle-value offer-note" data-offer-cell="@offer.Id">@field.DisplayOrOpen(offer.Latest.Terms, T)</td>
                                }
                            </tr>
                        }
                    </tbody>
                }
                @if (Model.OfferCriteria.Count > 0)
                {
                    <tbody>
                        <tr class="vehicle-group-heading">
                            <th colspan="@columnCount" scope="colgroup">
                                <span class="comparison-group-label">@T["OfferAssessmentTitle"]</span>
                            </th>
                        </tr>
                        @foreach (var criterion in Model.OfferCriteria)
                        {
                            <tr data-offer-comparison-criterion="@criterion.Id">
                                <th scope="row" class="vehicle-criterion">
                                    <strong>@criterion.Name</strong>
                                    <span class="comparison-requirement">
                                        @T[criterion.Priority.ToString()] · @T[criterion.Type.ToString()]
                                        @if (criterion.Type == CriterionType.Measurement)
                                        {
                                            <span> @(criterion.Comparison == Comparison.AtLeast ? "≥" : "≤") @criterion.Threshold @criterion.Unit</span>
                                        }
                                    </span>
                                </th>
                                @foreach (var offer in selected)
                                {
                                    var row = new OfferAssessmentRow(evaluation, offer, criterion, Model.Access);
                                    var assessment = row.Assessment;

                                    <td class="vehicle-value assessment-cell" data-offer-cell="@offer.Id" data-result="@row.ResultClass">
                                        <a
                                            class="comparison-edit"
                                            href="/evaluations/@evaluation.Id/offers/@offer.Id?@Model.Query#@row.FieldId"
                                            aria-label="@T["EditAssessmentFor", criterion.Name, offer.Latest.Terms.Name]">
                                            <span class="comparison-value">@row.AnswerText(T)</span>
                                            <span class="fulfillment @row.ResultClass">@T[row.ShortResultKey]</span>
                                            @if (assessment?.Source is { } source && source != AssessmentSource.Unknown)
                                            {
                                                <span class="comparison-source">@T["AssessmentSource" + source]</span>
                                            }
                                            @if (row.Stale)
                                            {
                                                <span class="comparison-note offer-stale">@T["OfferAssessmentStale", assessment!.RevisionNumber]</span>
                                            }
                                            @if (row.LinkedLine is { } linked)
                                            {
                                                <span class="comparison-note">@T["OfferLineFulfils", linked.Name]</span>
                                            }
                                            @if (assessment?.Notes.Length > 0)
                                            {
                                                <span class="comparison-note">@assessment.Notes</span>
                                            }
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    }
</section>
