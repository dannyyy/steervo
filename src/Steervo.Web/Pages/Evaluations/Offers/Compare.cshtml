@page "/evaluations/{id:guid}/offers/compare"
@model Steervo.Web.Pages.Evaluations.Offers.CompareModel
@using Steervo.Web.Pages.Evaluations.Offers
@{ ViewData["Title"] = T["OfferCompare"]; var e = Model.Evaluation; var selected = Model.Selected; }
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(e, Model.Access, "offers")' />
<a asp-page="Index" asp-route-id="@e.Id" class="back-link"><partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T["AllOffers"]</a>
<section class="comparison-surface">
<div class="comparison-introduction"><h2>@T["OfferCompare"]</h2><p class="muted">@T["OfferCompareHelp"]</p></div>
@if (Model.Notice is not null) { <p class="notice failure" role="alert">@Model.Notice</p> }
@if (e.Offers.Count > 0)
{
    <form method="get" class="comparison-picker"><div><label for="offer-compare-first">@T["FirstOffer"]</label><select id="offer-compare-first" name="first">@foreach (var offer in e.Offers) { <option value="@offer.Id" selected="@(offer.Id == Model.First?.Id)">@e.FindCandidate(offer.CandidateId).DisplayName · @offer.Latest.Terms.Name @(offer.Archived ? "· " + T["OfferArchivedLabel"] : "")</option> }</select></div><div><label for="offer-compare-second">@T["SecondOffer"]</label><select id="offer-compare-second" name="second"><option value="">@T["SelectOffer"]</option>@foreach (var offer in e.Offers) { <option value="@offer.Id" selected="@(offer.Id == Model.Second?.Id)">@e.FindCandidate(offer.CandidateId).DisplayName · @offer.Latest.Terms.Name @(offer.Archived ? "· " + T["OfferArchivedLabel"] : "")</option> }</select></div><button class="button secondary">@T["ShowComparison"]</button></form>
}
@if (selected.Count < 2) { <p class="notice">@T["OfferCompareNeedTwo"]</p> }
@if (selected.Count > 0)
{
    <p class="comparison-scroll-hint" id="offer-scroll-hint">@T["ComparisonScrollHint"]</p>
    <div id="offer-comparison-scroll" class="comparison-scroll" tabindex="0" role="region" aria-label="@T["OfferComparisonRegion"]" aria-describedby="offer-scroll-hint" data-focus-offer="@Request.Query["focus"]">
    <table class="vehicle-table offer-table @(selected.Count == 1 ? "vehicle-table-single" : null)"><caption class="visually-hidden">@T["OfferCompare"] · @e.FindCandidate(selected[0].CandidateId).DisplayName · @e.Currency</caption><colgroup><col class="criterion-column" />@foreach (var offer in selected) { <col /> }</colgroup>
    <thead><tr><th scope="col">@e.FindCandidate(selected[0].CandidateId).DisplayName<br />@e.Currency</th>@foreach (var offer in selected) { <th scope="col" data-offer-column="@offer.Id"><a asp-page="Details" asp-route-id="@e.Id" asp-route-offerId="@offer.Id" asp-route-first="@Model.First?.Id" asp-route-second="@Model.Second?.Id" class="comparison-candidate-link">@offer.Latest.Terms.Name<partial name="/Pages/Shared/_Icon.cshtml" model='"arrow"' /></a><span class="badge">@T["OfferVersion", offer.Latest.Number]</span>@if (offer.Archived) { <span class="badge">@T["OfferArchivedLabel"]</span> }<p class="micro">@T["OfferKind" + offer.Latest.Terms.Kind] · @T["OfferCommitment" + offer.Latest.Terms.Commitment]</p>@if (Model.Access >= AccessLevel.Editor && !offer.Archived) { <a class="text-link" asp-page="Edit" asp-route-id="@e.Id" asp-route-offerId="@offer.Id" asp-route-first="@Model.First?.Id" asp-route-second="@Model.Second?.Id">@T["OfferEdit"]</a> }</th> }</tr></thead>
    @foreach (var group in OfferFields.All.Where(field => field.Name != "Name").GroupBy(field => field.Group))
    {
        var fields = group.ToList();
        if (group.Key == "Contract" && !selected.Any(offer => offer.Latest.Terms.Kind is OfferKind.Leasing or OfferKind.Financing || fields.Any(field => field.Raw(offer.Latest.Terms) is not null))) { continue; }
        if (group.Key == "Mileage" && !selected.Any(offer => offer.Latest.Terms.Kind == OfferKind.Leasing || fields.Any(field => field.Raw(offer.Latest.Terms) is not null))) { continue; }
        <tbody><tr class="vehicle-group-heading"><th colspan="@(selected.Count + 1)" scope="colgroup">@T["OfferGroup" + group.Key]</th></tr>
        @foreach (var field in fields)
        {
            <tr data-offer-comparison-field="@field.Name"><th scope="row" class="vehicle-criterion">@T[field.Label] @if (field.Type is "money" or "unitprice") { <span class="field-unit">@e.Currency</span> }</th>@foreach (var offer in selected) { var value = field.Display(offer.Latest.Terms); <td class="vehicle-value offer-note" data-offer-cell="@offer.Id">@(string.IsNullOrEmpty(value) ? T["OfferOpen"].Value : value)</td> }</tr>
        }
        </tbody>
    }
    <tbody><tr class="vehicle-group-heading"><th colspan="@(selected.Count + 1)" scope="colgroup">@T["OfferLines"]</th></tr><tr><th scope="row" class="vehicle-criterion">@T["OfferLinesHelp"]</th>@foreach (var offer in selected) { <td class="vehicle-value"><partial name="_OfferLines" model="new OfferSnapshot(offer.Latest, e.Currency)" /></td> }</tr></tbody>
    @if (e.Criteria.Any(criterion => criterion.Scope == CriterionScope.Offer))
    {
        <tbody><tr class="vehicle-group-heading"><th colspan="@(selected.Count + 1)" scope="colgroup">@T["OfferAssessmentTitle"]</th></tr>
        @foreach (var criterion in e.Criteria.Where(criterion => criterion.Scope == CriterionScope.Offer).OrderBy(criterion => criterion.Position))
        {
            <tr><th scope="row" class="vehicle-criterion"><strong>@criterion.Name</strong><span class="assessment-requirement">@T[criterion.Priority.ToString()] · @T[criterion.Type.ToString()] @if (criterion.Type == CriterionType.Measurement) { <span> · @(criterion.Comparison == Comparison.AtLeast ? "≥" : "≤") @criterion.Threshold @criterion.Unit</span> }</span></th>
            @foreach (var offer in selected)
            {
                var row = new OfferAssessmentRow(e, offer, criterion, Model.Access); var value = row.Assessment;
                <td class="vehicle-value"><span class="fulfillment @row.Result.ToString().ToLowerInvariant()">@T["Fulfillment" + row.Result]</span><p class="comparison-value">@(criterion.Type == CriterionType.Boolean ? T[value?.BooleanValue is { } boolean ? boolean ? "Yes" : "No" : "FulfillmentUnknown"].Value : criterion.Type == CriterionType.Rating ? value?.RatingValue is { } rating ? $"{rating} / 5" : T["FulfillmentUnknown"].Value : value?.MeasurementValue is { } number ? $"{number:G} {criterion.Unit}" : T["FulfillmentUnknown"].Value)</p><p class="micro">@T["AssessmentSource" + (value?.Source ?? AssessmentSource.Unknown)]</p>@if (row.Stale) { <p class="offer-review">@T["OfferAssessmentStale", value!.RevisionNumber]</p> }@if (value?.Notes.Length > 0) { <p class="offer-note">@value.Notes</p> }<a class="text-link" asp-page="Details" asp-route-id="@e.Id" asp-route-offerId="@offer.Id" asp-route-first="@Model.First?.Id" asp-route-second="@Model.Second?.Id" asp-fragment="@row.FieldId">@T["OfferAssessmentTitle"]</a></td>
            }
            </tr>
        }
        </tbody>
    }
    </table></div>
}
</section>
