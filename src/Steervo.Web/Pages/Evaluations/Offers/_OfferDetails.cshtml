@model Steervo.Web.Pages.Evaluations.Offers.DetailsModel
@using Steervo.Web.Pages.Evaluations.Offers
@{
    var evaluation = Model.Evaluation;
    var offer = Model.Offer;
    var revision = Model.Revision;
    var terms = revision.Terms;
    var candidate = Model.Candidate;
    var missing = revision.MissingFields().ToArray();
    var offerCriteria = Model.OfferCriteria;
}
<div
    id="offer-workspace"
    data-version="@evaluation.Version"
    data-offer-id="@offer.Id"
    data-revision="@revision.Number"
    data-preserve-viewport
    hx-target="#offer-workspace"
    hx-swap="outerHTML show:none focus-scroll:false"
    hx-sync="this:drop"
    hx-disabled-elt="find button[type=submit]">
    <partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(evaluation, Model.Access, "offers", candidate.Id)' />
    @if (Model.Notice is not null && Model.Draft is null)
    {
        <div class="notice workspace-notice @(Model.Failed ? "failure" : "success")" role="@(Model.Failed ? "alert" : "status")" tabindex="-1">@Model.Notice</div>
    }
    <a class="back-link" asp-page="Index" asp-route-id="@evaluation.Id" asp-route-candidateId="@candidate.Id"><partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T["AllOffers"]</a>
    <section class="workspace-surface offer-record">
        <div class="offer-introduction">
            <div>
                <p class="editor-context">
                    <a asp-page="/Evaluations/Candidates/Details" asp-route-id="@evaluation.Id" asp-route-candidateId="@candidate.Id">@candidate.DisplayName</a>
                </p>
                <h2>@terms.Name</h2>
                <p class="offer-provider">@(OfferParties.Summary(terms, T) ?? T["OfferOpen"].Value)</p>
                <div class="offer-badges">
                    <span class="badge">@T["OfferKind" + terms.Kind]</span>
                    <span class="badge">@T["OfferCommitment" + terms.Commitment]</span>
                    <span class="badge">@T["OfferVersion", revision.Number]</span>
                    <span class="badge">@evaluation.Currency</span>
                </div>
                <div class="vehicle-actions">
                    @if (Model.CanChange)
                    {
                        <a
                            class="button primary"
                            asp-page="Edit"
                            asp-route-id="@evaluation.Id"
                            asp-route-offerId="@offer.Id"
                            asp-route-first="@Model.First"
                            asp-route-second="@Model.Second">@T["OfferEdit"]</a>
                    }
                    <a class="button secondary" href="/evaluations/@evaluation.Id/offers/compare@(Model.ReturnContext)&focus=@offer.Id">@T["OfferCompare"]</a>
                    @if (Model.CanChange)
                    {
                        <form
                            method="post"
                            hx-post="@(Model.OfferUrl)@(Model.ReturnContext)"
                            class="vehicle-remove"
                            data-confirm-action="@T["RemoveOfferNamed", terms.Name]"
                            data-confirm-description="@T["RemoveOfferConfirm"]">
                            <input type="hidden" name="version" value="@evaluation.Version" />
                            <input type="hidden" name="action" value="remove-offer" />
                            <button type="submit" id="remove-offer" class="button secondary danger">@T["RemoveOffer"]</button>
                        </form>
                    }
                </div>
            </div>
        </div>
        <nav class="record-sections" aria-label="@T["OfferContents"]">
            <a href="#offer-facts">@T["OfferOverview"]</a>
            @if (Model.Current)
            {
                <a href="#offer-assessments">@T["OfferAssessmentTitle"]</a>
            }
            <a href="#documents">@T["Documents"]</a>
            <a href="#offer-history">@T["OfferHistory"]</a>
        </nav>
        @if (!Model.Current)
        {
            <p class="notice">@T["OfferHistorical"] <a asp-page="Details" asp-route-id="@evaluation.Id" asp-route-offerId="@offer.Id" asp-route-first="@Model.First" asp-route-second="@Model.Second">@T["OfferBackToCurrent"] →</a></p>
        }
        @if (missing.Length > 0)
        {
            <section class="offer-missing" id="offer-values">
                <h3>@T["OfferOpenFields"]</h3>
                <ul>
                    @foreach (var field in missing)
                    {
                        <li>@T["Offer" + field]</li>
                    }
                </ul>
            </section>
        }
        <partial name="_OfferValues" model="new OfferSnapshot(revision, evaluation.Currency)" />
        <section class="record-section offer-positions" id="offer-prices">
            <h3>@T["OfferLines"]</h3>
            <partial name="_OfferLines" model="new OfferSnapshot(revision, evaluation.Currency, offerCriteria)" />
            <partial name="_OfferPricing" model="new OfferSnapshot(revision, evaluation.Currency)" />
        </section>
        @if (Model.PreviousRevision is { } previous)
        {
            <details class="record-section offer-diff" id="offer-differences">
                <summary>@T["OfferChanges"]</summary>
                <dl class="offer-differences">
                    @if (terms.Kind != previous.Terms.Kind)
                    {
                        <div>
                            <dt>@T["OfferKind"]</dt>
                            <dd><del>@T["OfferKind" + previous.Terms.Kind]</del> → <ins>@T["OfferKind" + terms.Kind]</ins></dd>
                        </div>
                    }
                    @if (terms.Commitment != previous.Terms.Commitment)
                    {
                        <div>
                            <dt>@T["OfferCommitment"]</dt>
                            <dd><del>@T["OfferCommitment" + previous.Terms.Commitment]</del> → <ins>@T["OfferCommitment" + terms.Commitment]</ins></dd>
                        </div>
                    }
                    @foreach (var field in Model.ChangedFields(previous))
                    {
                        <div data-offer-change="@field.Name">
                            <dt>@T[field.Label]</dt>
                            <dd>
                                <del>@field.DisplayOrOpen(previous.Terms, T)</del> → <ins>@field.DisplayOrOpen(terms, T)</ins>
                                @if (field.IsMoney)
                                {
                                    <span>@evaluation.Currency</span>
                                }
                            </dd>
                        </div>
                    }
                </dl>
                @if (Model.LinesChangedSince(previous))
                {
                    <p>@T["OfferLinesChanged"]</p>
                    <div class="offer-line-diff">
                        <section>
                            <h4>@T["OfferVersion", previous.Number]</h4>
                            <partial name="_OfferLines" model="new OfferSnapshot(previous, evaluation.Currency, offerCriteria)" />
                        </section>
                        <section>
                            <h4>@T["OfferVersion", revision.Number]</h4>
                            <partial name="_OfferLines" model="new OfferSnapshot(revision, evaluation.Currency, offerCriteria)" />
                        </section>
                    </div>
                }
                @if (revision.ChangeNote.Length > 0)
                {
                    <p class="offer-note">@revision.ChangeNote</p>
                }
            </details>
        }
        @if (Model.Current)
        {
            <section class="record-section offer-assessments" id="offer-assessments">
                <div class="section-heading">
                    <h3>@T["OfferAssessmentTitle"]</h3>
                </div>
                @foreach (var group in Model.AssessmentGroups)
                {
                    <section class="assessment-group">
                        <h4>@(group.Group?.Name ?? T["Ungrouped"].Value)</h4>
                        @foreach (var criterion in group.Criteria)
                        {
                            <partial name="_OfferAssessment" model="new OfferAssessmentRow(evaluation, offer, criterion, Model.Access, Model.Draft, Model.ReturnContext)" />
                        }
                    </section>
                }
                @if (offerCriteria.Count == 0)
                {
                    <p class="muted">@T["OfferNoCriteria"] <a asp-page="/Evaluations/Details" asp-route-id="@evaluation.Id" asp-route-section="criteria">@T["EditCriteria"] →</a></p>
                }
            </section>
        }
        <partial name="_OfferDocuments" model="Model" />
        <section class="record-section offer-history" id="offer-history">
            <h3>@T["OfferHistory"]</h3>
            <ol>
                @foreach (var item in offer.Revisions.OrderByDescending(item => item.Number))
                {
                    <li data-offer-version="@item.Number">
                        <div>
                            <a
                                asp-page="Details"
                                asp-route-id="@evaluation.Id"
                                asp-route-offerId="@offer.Id"
                                asp-route-revision="@item.Number"
                                asp-route-first="@Model.First"
                                asp-route-second="@Model.Second"
                                aria-current="@(item.Number == revision.Number ? "page" : null)">@T["OfferVersion", item.Number]</a>
                            <time datetime="@item.CreatedAt.ToString("O")">@DetailsModel.FormatTimestamp(item.CreatedAt)</time>
                            @if (item.Number == offer.Latest.Number)
                            {
                                <span class="badge">@T["OfferCurrent"]</span>
                            }
                        </div>
                        <p>@(item.ChangeNote.Length > 0 ? item.ChangeNote : T["OfferNoChangeNote"].Value)</p>
                    </li>
                }
            </ol>
        </section>
    </section>
</div>
