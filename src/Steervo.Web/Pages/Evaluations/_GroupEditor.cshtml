@model Steervo.Web.Pages.Evaluations.GroupEditor
@using Steervo.Web.Pages.Shared
@{
    var g = Model.Group; var workspace = Model.Workspace; var e = workspace.Evaluation;
    var prefix = g?.Id.ToString() ?? "new"; var action = g is null ? "add-group" : "rename-group";
    var failed = workspace.DraftFor(action, g?.Id ?? default) is not null || (g is not null && workspace.FailedAction == "remove-group" && workspace.FailedItemId == g.Id);
}
<div id="@(g is null ? "new-group-editor" : "group-editor-" + prefix)" class="inline-editor group-editor" data-editor data-opener="@(g is null ? "add-group" : "edit-group-" + prefix)" data-focus-fallback="criteria-title" hidden="@(!failed)" aria-labelledby="group-title-@prefix">
    <div class="editor-heading"><div><p class="editor-context">@(g?.Name ?? e.Name)</p><h3 id="group-title-@prefix">@T[g is null ? "AddGroup" : "EditGroup"]</h3></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
    <div class="editor-error" role="alert" tabindex="-1" hidden="@(!failed)">@(failed ? workspace.Notice : null)</div>
    <form method="post" hx-post="/evaluations/@e.Id" data-guard-draft data-submitted-values="@workspace.DraftFor(action, g?.Id ?? default)"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="@action" />@if (g is not null) { <input type="hidden" name="itemId" value="@g.Id" /> }
        <label for="group-name-@prefix">@T["GroupName"]</label><input id="group-name-@prefix" name="name" value="@g?.Name" required maxlength="160" /><p class="editor-help">@T["GroupHelp"]</p><partial name="/Pages/Shared/_EditorActions.cshtml" model='new EditorActions("save-group-" + prefix, g is null ? T["AddGroup"].Value : null)' />
    </form>
    @if (g is not null) { <form method="post" hx-post="/evaluations/@e.Id" class="editor-reset" data-confirm-action="@T["RemoveGroupNamed", g.Name]" data-confirm-description="@T["RemoveGroupConfirm"]"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="remove-group" /><input type="hidden" name="itemId" value="@g.Id" /><button type="submit" class="text-button danger">@T["RemoveGroup"]</button></form> }
</div>
