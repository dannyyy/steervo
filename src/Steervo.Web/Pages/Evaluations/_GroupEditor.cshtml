@model Steervo.Web.Pages.Evaluations.GroupEditor
@using Steervo.Web.Pages.Shared
@{
    var group = Model.Group;
    var workspace = Model.Workspace;
    var evaluation = workspace.Evaluation;
    var prefix = Model.Prefix;
    var submitLabel = Model.IsNew ? T["AddGroup"].Value : null;
    var actions = new EditorActions("save-group-" + prefix, submitLabel);
}
<div
    id="@Model.EditorId"
    class="inline-editor group-editor"
    data-editor
    data-opener="@Model.OpenerId"
    data-focus-fallback="criteria-title"
    hidden="@(!Model.Failed)"
    aria-labelledby="group-title-@prefix"
>
    <div class="editor-heading">
        <div>
            <p class="editor-context">@(group?.Name ?? evaluation.Name)</p>
            <h3 id="group-title-@prefix">@T[Model.IsNew ? "AddGroup" : "EditGroup"]</h3>
        </div>
        <button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]">
            <partial name="/Pages/Shared/_Icon.cshtml" model='"close"' />
        </button>
    </div>
    <div
        class="editor-error"
        role="alert"
        tabindex="-1"
        hidden="@(!Model.Failed)"
    >@(Model.Failed ? workspace.Notice : null)</div>
    <form
        method="post"
        hx-post="/evaluations/@evaluation.Id"
        data-guard-draft
        data-submitted-values="@Model.Draft"
    >
        <input type="hidden" name="version" value="@evaluation.Version" />
        <input type="hidden" name="action" value="@Model.Action" />
        @if (group is not null)
        {
            <input type="hidden" name="itemId" value="@group.Id" />
        }
        <label for="group-name-@prefix">@T["GroupName"]</label>
        <input id="group-name-@prefix" name="name" value="@group?.Name" required maxlength="160" />
        <p class="editor-help">@T["GroupHelp"]</p>
        <partial name="/Pages/Shared/_EditorActions.cshtml" model="actions" />
    </form>
    @if (group is not null)
    {
        <form
            method="post"
            hx-post="/evaluations/@evaluation.Id"
            class="editor-reset"
            data-confirm-action="@T["RemoveGroupNamed", group.Name]"
            data-confirm-description="@T["RemoveGroupConfirm"]"
        >
            <input type="hidden" name="version" value="@evaluation.Version" />
            <input type="hidden" name="action" value="remove-group" />
            <input type="hidden" name="itemId" value="@group.Id" />
            <button type="submit" class="text-button danger">@T["RemoveGroup"]</button>
        </form>
    }
</div>
