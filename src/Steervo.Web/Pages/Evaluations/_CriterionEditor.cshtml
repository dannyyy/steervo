@model Steervo.Web.Pages.Evaluations.CriterionEditor
@if (Model.IsNew)
{
    <partial name="_CriterionEditorFields" model="Model" />
}
else
{
    <div
        id="criterion-editor-@Model.Prefix"
        class="inline-editor"
        data-editor
        data-opener="edit-criterion-@Model.Prefix"
        data-focus-fallback="criteria-title"
        hidden="@(!Model.Failed)"
        aria-labelledby="criterion-title-@Model.Prefix"
    >
        <partial name="_CriterionEditorFields" model="Model" />
    </div>
}
