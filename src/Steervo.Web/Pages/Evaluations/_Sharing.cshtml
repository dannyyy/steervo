@model Steervo.Web.Pages.Evaluations.DetailsModel
@using Steervo.Web.Pages.Evaluations
@{
    var evaluation = Model.Evaluation;
    var isOwner = Model.IsOwner;
}
<section
    id="sharing"
    class="workspace-surface"
    data-evaluation-section="sharing"
    hidden="@(Model.Section != "settings")"
    aria-labelledby="sharing-title"
>
    <div class="surface-heading">
        <div>
            <h2 id="sharing-title" tabindex="-1">@T["Access"]</h2>
            <p class="muted">@T[isOwner ? "SharingHelp" : "OwnerManagesAccess"]</p>
        </div>
        @if (isOwner)
        {
            <button
                type="button"
                id="add-share"
                class="button primary"
                data-editor-open="share-editor-new"
                aria-expanded="false"
            >
                <partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />
                @T["GrantAccess"]
            </button>
        }
    </div>
    @if (isOwner)
    {
        <partial name="_ShareEditor" model='new ShareEditor(Model, "new", "", AccessLevel.Reader)' />
        @if (evaluation.Shares.Count == 0)
        {
            <div class="canvas-empty">
                <partial name="/Pages/Shared/_Icon.cshtml" model='"people"' />
                <h3>@T["NoShares"]</h3>
                <p>@T["PrivateByDefault"]</p>
            </div>
        }
        @foreach (var share in evaluation.Shares)
        {
            var email = Model.ShareEmails.GetValueOrDefault(share.UserId, "—");
            var editor = new ShareEditor(Model, share.UserId, email, share.Access);

            <article class="share-entry" id="share-@share.UserId">
                <div class="share-row">
                    <span>@email</span>
                    <span class="badge">@T[share.Access.ToString()]</span>
                    <div class="row-actions">
                        <button
                            type="button"
                            class="icon-button"
                            id="edit-share-@share.UserId"
                            data-editor-open="share-editor-@share.UserId"
                            aria-expanded="false"
                            aria-label="@T["EditShareNamed", email]"
                        >
                            <partial name="/Pages/Shared/_Icon.cshtml" model='"edit"' />
                        </button>
                        <form
                            method="post"
                            hx-post="/evaluations/@evaluation.Id?section=sharing"
                            data-focus-fallback="sharing-title"
                        >
                            <input type="hidden" name="version" value="@evaluation.Version" />
                            <input type="hidden" name="action" value="revoke" />
                            <input type="hidden" name="userId" value="@share.UserId" />
                            <button type="submit" class="text-button">@T["Revoke"]</button>
                        </form>
                    </div>
                </div>
                <partial name="_ShareEditor" model="editor" />
            </article>
        }
    }
</section>
