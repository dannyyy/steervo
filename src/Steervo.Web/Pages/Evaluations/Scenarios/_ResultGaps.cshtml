@model Steervo.Web.Pages.Evaluations.Scenarios.ScenarioPanel
@{
    var result = Model.Result;

    // A leased vehicle that is returned has no residual value, so none can be missing.
    var keepsVehicle = Model.Scenario.Terms.Mode != AcquisitionMode.LeaseReturn;
    var residualMissing = result.ExpectedResidual is null && keepsVehicle;
}
@if (result.Issues.Count > 0 || residualMissing)
{
    <div class="scenario-gaps">
        <strong>@T["ScenarioIncomplete"]</strong>
        <ul>
            @foreach (var issue in result.Issues)
            {
                <li>@T[issue.Code] @issue.Detail</li>
            }
            @if (residualMissing)
            {
                <li>@T["ScenarioResidualMissing", result.Month]</li>
            }
        </ul>
    </div>
}
