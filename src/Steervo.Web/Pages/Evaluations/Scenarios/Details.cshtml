@page "/evaluations/{id:guid}/scenarios/{scenarioId:guid}"
@model Steervo.Web.Pages.Evaluations.Scenarios.DetailsModel
@using Steervo.Web.Pages.Evaluations.Scenarios
@{ var e = Model.Evaluation; var s = Model.Scenario; var offer = e.FindOffer(s.OfferId); var edit = Model.Access >= AccessLevel.Editor; ViewData["Title"] = s.Name; string Money(decimal? value) => value.HasValue ? $"{value:N2} {e.Currency}" : T["OfferOpen"].Value; }
<div id="scenario-detail" data-version="@e.Version">
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(e, Model.Access, "scenarios")' />
<a class="back-link" asp-page="Index" asp-route-id="@e.Id">← @T["ScenarioAll"]</a>
<div class="candidate-heading"><div><h2>@s.Name</h2><p class="muted">@e.FindCandidate(offer.CandidateId).DisplayName · <a asp-page="/Evaluations/Offers/Details" asp-route-id="@e.Id" asp-route-offerId="@offer.Id" asp-route-revision="@s.RevisionNumber">@offer.Revision(s.RevisionNumber).Terms.Name · @T["ScenarioVersion", s.RevisionNumber] ↗</a></p></div><div class="scenario-form-actions">@if (edit) { <a class="button secondary" asp-page="Edit" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id">@T["ScenarioEdit"]</a> }<a class="button primary" asp-page="Compare" asp-route-id="@e.Id" asp-route-leftId="@s.Id" asp-route-month="@Model.Month">@T["ScenarioCompare"]</a></div></div>
@if (offer.Latest.Number != s.RevisionNumber) { <p class="notice scenario-convention">@T["ScenarioNewOfferVersion", offer.Latest.Number]</p> }
@if (Model.Notice is not null) { <p class="notice failure" role="alert">@Model.Notice</p> }
<form method="get" class="scenario-horizon"><div><label for="scenario-month">@T["ScenarioCheckpoint"]</label><input id="scenario-month" name="month" value="@Model.Month" type="number" min="1" max="@e.CostPlanning!.Months" required /></div><button class="button secondary">@T["ScenarioCalculate"]</button><p class="micro">@T["ScenarioHorizonHelp", e.CostPlanning!.Start.ToString("MM.yyyy"), e.CostPlanning!.Months]</p></form>
<div class="scenario-detail-grid"><partial name="_Result" model="new ScenarioPanel(e, s, Model.Result)" />
<section class="panel scenario-components"><h3>@T["CalculationComposition"]</h3><p class="micro">@T["CalculationCompositionHelp"]</p><dl class="scenario-result-values">@foreach (var component in Model.Result.Components) { <div><dt>@(component.Name ?? T[component.Code].Value)</dt><dd>@(component.Complete ? Money(component.NetPayments) : T["OfferOpen"].Value)<small>@T["CalculationOpportunityShort"]: @(component.Complete && Model.Result.Issues.Count == 0 ? Money(component.OpportunityCost) : T["OfferOpen"].Value)</small></dd></div> }</dl>
@if (s.Notes.Length > 0) { <h4>@T["ScenarioNotes"]</h4><p class="scenario-note">@s.Notes</p> }
<p class="micro">@T["ScenarioLiveCosts"] <a asp-page="/Evaluations/Costs/Index" asp-route-id="@e.Id" asp-route-candidateId="@offer.CandidateId">@T["Costs"] →</a></p></section></div>
@if (s.Terms.Mode != AcquisitionMode.LeaseReturn)
{
<section class="panel scenario-section" id="scenario-residuals"><h3>@T["ScenarioResiduals"]</h3><p class="muted">@T["ScenarioResidualHelp"]</p>
@if (s.Terms.AnnualKilometres is { } kilometres) { <p class="micro">@T["ScenarioResidualMileage", kilometres.ToString("N0")]</p> }
<p class="micro">@T["ScenarioResidualMileageHelp"]</p>
<div class="scenario-checkpoints">@foreach (var point in s.Residuals.OrderBy(r => r.Month)) { <article data-residual-month="@point.Month"><div><strong>@T["CostFromMonth", point.Month] · @e.CostPlanning!.DateFor(point.Month).ToString("MM.yyyy")</strong><p class="micro">@T["ResidualLow"]: @Money(point.Low) · @T["ResidualExpected"]: @Money(point.Expected) · @T["ResidualHigh"]: @Money(point.High)</p>@if (point.Notes.Length > 0) { <p class="scenario-note">@point.Notes</p> }</div>
@if (edit) { <div class="scenario-inline-actions"><a asp-page="Details" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id" asp-route-month="@Model.Month" asp-route-residualMonth="@point.Month" asp-fragment="residual-form">@T["Edit"]</a><form method="post" data-confirm="@T["ResidualDeleteConfirm"]"><input type="hidden" name="action" value="remove-residual" /><input type="hidden" name="Version" value="@e.Version" /><input type="hidden" name="residualMonth" value="@point.Month" /><button class="text-button danger">@T["ResidualDelete"]</button></form></div> }</article> }</div>
@if (edit)
{
<form method="post" id="residual-form" class="scenario-secondary-form"><input type="hidden" name="action" value="residual" /><input asp-for="Version" type="hidden" />
<div class="scenario-residual-fields"><div><label asp-for="Residual.Month">@T["ScenarioCheckpoint"]</label><input asp-for="Residual.Month" type="number" min="1" max="1200" required /></div><div><label asp-for="Residual.Low">@T["ResidualLow"] (@e.Currency)</label><input asp-for="Residual.Low" type="number" min="0" max="1000000000000" step="0.01" /></div><div><label asp-for="Residual.Expected">@T["ResidualExpected"] (@e.Currency)</label><input asp-for="Residual.Expected" type="number" min="0" max="1000000000000" step="0.01" /></div><div><label asp-for="Residual.High">@T["ResidualHigh"] (@e.Currency)</label><input asp-for="Residual.High" type="number" min="0" max="1000000000000" step="0.01" /></div></div>
<label asp-for="Residual.Notes">@T["ResidualNotes"]</label><textarea asp-for="Residual.Notes" rows="2" maxlength="2000"></textarea><button class="button primary">@T["ResidualSave"]</button><p class="micro">@T["ResidualSaveHelp"]</p></form>
}
</section>
}
<section class="panel scenario-section" id="scenario-adjustments"><h3>@T["ScenarioAdjustments"]</h3><p class="muted">@T["ScenarioAdjustmentsHelp"]</p>
<div class="scenario-checkpoints">@foreach (var adjustment in s.CostAdjustments.OrderBy(a => e.FindCost(a.CostId).Name)) { <article data-adjusted-cost="@adjustment.CostId"><div><strong>@e.FindCost(adjustment.CostId).Name · @Money(adjustment.Amount)</strong><p class="micro">@T["CostFromMonth", adjustment.StartMonth] @if (adjustment.EndMonth.HasValue) { <span>– @T["CostThroughMonth", adjustment.EndMonth.Value]</span> }</p>@if (adjustment.Notes.Length > 0) { <p class="scenario-note">@adjustment.Notes</p> }</div>
@if (edit) { <div class="scenario-inline-actions"><a asp-page="Details" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id" asp-route-month="@Model.Month" asp-route-costId="@adjustment.CostId" asp-fragment="adjustment-form">@T["Edit"]</a><form method="post" data-confirm="@T["AdjustmentDeleteConfirm"]"><input type="hidden" name="action" value="remove-adjustment" /><input type="hidden" name="Version" value="@e.Version" /><input type="hidden" name="costId" value="@adjustment.CostId" /><button class="text-button danger">@T["AdjustmentDelete"]</button></form></div> }</article> }</div>
@if (edit && Model.Costs.Count > 0)
{
<form method="post" id="adjustment-form" class="scenario-secondary-form"><input type="hidden" name="action" value="adjustment" /><input asp-for="Version" type="hidden" /><div class="scenario-number-grid"><div><label asp-for="Adjustment.CostId">@T["AdjustmentCost"]</label><select asp-for="Adjustment.CostId" required><option value="">@T["Choose"]</option>@foreach (var cost in Model.Costs) { <option value="@cost.Id">@cost.Name · @T["CostFrequency" + cost.Frequency]</option> }</select></div><div><label asp-for="Adjustment.Amount">@T["AdjustmentAmount"] (@e.Currency)</label><input asp-for="Adjustment.Amount" type="number" min="0" max="1000000000000" step="0.01" /></div><div><label asp-for="Adjustment.StartMonth">@T["CostFirstMonth"]</label><input asp-for="Adjustment.StartMonth" type="number" min="1" max="1200" required /></div><div><label asp-for="Adjustment.EndMonth">@T["CostLastMonth"]</label><input asp-for="Adjustment.EndMonth" type="number" min="1" max="1200" /></div></div><label asp-for="Adjustment.Notes">@T["AdjustmentNotes"]</label><textarea asp-for="Adjustment.Notes" rows="2" maxlength="2000"></textarea><button class="button primary">@T["AdjustmentSave"]</button></form>
}
</section>
<section class="panel scenario-section"><div class="cost-timeline-heading"><div><h3>@T["ScenarioPaymentSchedule"]</h3><p class="micro">@T["ScenarioScheduleHelp"]</p></div><nav class="cost-period-switch" aria-label="@T["CostDisplay"]"><a asp-page="Details" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id" asp-route-month="@Model.Month" asp-route-period="month" asp-fragment="scenario-payments" aria-current="@(Model.Period == "month" ? "page" : null)">@T["CostMonthlyView"]</a><a asp-page="Details" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id" asp-route-month="@Model.Month" asp-route-period="year" asp-fragment="scenario-payments" aria-current="@(Model.Period == "year" ? "page" : null)">@T["CostYearlyView"]</a></nav></div>
<div id="scenario-payments" class="cost-table-scroll" tabindex="0" role="region" aria-label="@T["ScenarioPaymentSchedule"]"><table class="cost-table scenario-payment-table"><thead><tr><th>@T["CostPeriod"]</th><th>@T["ScenarioStartPayments"]</th><th>@T["ScenarioEndPayments"]</th><th>@T["ScenarioAccountInterest"]</th><th>@T["CalculationAccount"]</th><th>@T["CalculationRemainingDebt"]</th></tr></thead><tbody>
@foreach (var rows in Model.Periods) { var last = rows[^1]; <tr data-payment-month="@rows[0].Month"><th scope="row">@e.CostPlanning!.DateFor(rows[0].Month).ToString(Model.Period == "year" ? "yyyy" : "MM.yyyy")<span class="micro">@T["CostMonthRange", rows[0].Month, last.Month]</span></th><td>@Money(rows.Sum(m => m.StartExpenses - m.StartIncome))</td><td>@Money(rows.Sum(m => m.EndExpenses - m.EndIncome))</td><td>@(Model.Result.Issues.Count == 0 ? Money(rows.Sum(m => m.Interest)) : T["OfferOpen"].Value)</td><td>@(Model.Result.Issues.Count == 0 ? Money(last.Account) : T["OfferOpen"].Value)</td><td>@(Model.Result.Issues.Count == 0 ? Money(last.Debt) : T["OfferOpen"].Value)</td></tr> }
</tbody></table></div>
@if (Model.PageCount > 1) { <nav class="cost-pagination">@if (Model.PageNumber > 1) { <a asp-page="Details" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id" asp-route-month="@Model.Month" asp-route-period="@Model.Period" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-fragment="scenario-payments">← @T["CostPrevious"]</a> }<span>@T["CostPage", Model.PageNumber, Model.PageCount]</span>@if (Model.PageNumber < Model.PageCount) { <a asp-page="Details" asp-route-id="@e.Id" asp-route-scenarioId="@s.Id" asp-route-month="@Model.Month" asp-route-period="@Model.Period" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-fragment="scenario-payments">@T["CostNext"] →</a> }</nav> }</section>
@if (edit) { <details class="panel scenario-section"><summary>@T["ScenarioCopy"]</summary><form method="post"><input type="hidden" name="action" value="copy" /><input asp-for="Version" type="hidden" /><label asp-for="CopyName">@T["ScenarioCopyName"]</label><input asp-for="CopyName" maxlength="160" required /><button class="button secondary">@T["ScenarioCopy"]</button></form></details> }
</div>
