@model Steervo.Web.Pages.Evaluations.Scenarios.DetailsModel
<section id="scenario-copy-editor" class="inline-editor scenario-inline-editor" data-editor data-opener="open-scenario-copy" aria-labelledby="scenario-copy-title" hidden="@(Model.FailedAction != "copy")">
<div class="editor-heading"><div><p class="editor-context">@Model.Scenario.Name</p><h3 id="scenario-copy-title">@T["ScenarioCopy"]</h3></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
<div class="editor-error" role="alert" tabindex="-1" hidden="@(Model.FailedAction != "copy")">@Model.Notice</div>
<form method="post" hx-post="@Model.ContextUrl" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-guard-draft data-retain-on-error><input type="hidden" name="action" value="copy" /><input name="Version" value="@Model.Version" type="hidden" /><label asp-for="CopyName">@T["ScenarioCopyName"]</label><input asp-for="CopyName" maxlength="160" required data-editor-focus />
<partial name="/Pages/Shared/_EditorActions.cshtml" model='new Steervo.Web.Pages.Shared.EditorActions("save-scenario-copy", T["ScenarioCopy"].Value)' />
</form></section>
