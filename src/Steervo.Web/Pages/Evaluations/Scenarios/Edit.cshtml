@page "/evaluations/{id:guid}/scenarios/edit/{scenarioId:guid?}"
@model Steervo.Web.Pages.Evaluations.Scenarios.EditModel
@using Steervo.Web.Pages.Evaluations.Scenarios
@{ ViewData["Title"] = T[Model.Scenario is null ? "ScenarioAdd" : "ScenarioEdit"].Value; var e = Model.Evaluation; }
<a class="back-link" asp-page="Index" asp-route-id="@e.Id">← @T["Calculations"]</a>
@if (Model.Offer is not { } offer)
{
<section class="panel scenario-editor"><h1>@T["ScenarioChooseOffer"]</h1><p class="muted">@T["ScenarioChooseOfferHelp"]</p>
<div class="scenario-offer-picker">@foreach (var option in e.Offers.OrderBy(o => e.FindCandidate(o.CandidateId).DisplayName).ThenBy(o => o.Latest.Terms.Name))
{ <a class="scenario-offer-option" asp-page="Edit" asp-route-id="@e.Id" asp-route-offerId="@option.Id"><strong>@option.Latest.Terms.Name</strong><span>@e.FindCandidate(option.CandidateId).DisplayName · @T["ScenarioVersion", option.Latest.Number] @if (option.Archived) { <span>· @T["OfferArchivedLabel"]</span> }</span><span>→</span></a> }</div>
@if (e.Offers.Count == 0) { <a class="button primary" asp-page="/Evaluations/Offers/Index" asp-route-id="@e.Id">@T["Offers"] →</a> }</section>
}
else
{
<section class="panel scenario-editor"><p class="eyebrow">@e.FindCandidate(offer.CandidateId).DisplayName · @e.Currency</p><h1>@ViewData["Title"]</h1><p class="muted">@T["ScenarioEditHelp"]</p>
@if (Model.Notice is not null) { <p class="notice failure" role="alert">@Model.Notice</p> }
<form method="post" data-scenario-form><input asp-for="Version" type="hidden" /><input asp-for="Input.OfferId" type="hidden" />
<label asp-for="Input.Name">@T["ScenarioName"]</label><input asp-for="Input.Name" maxlength="160" required />
<div class="field-pair"><div><label asp-for="Input.Mode">@T["ScenarioMode"]</label><select asp-for="Input.Mode" data-scenario-mode>@foreach (var mode in Enum.GetValues<AcquisitionMode>()) { <option value="@mode">@T["Acquisition" + mode]</option> }</select></div>
<div><label asp-for="Input.RevisionNumber">@T["ScenarioSourceVersion"]</label><select asp-for="Input.RevisionNumber">@foreach (var revision in offer.Revisions.OrderByDescending(r => r.Number)) { <option value="@revision.Number">@T["ScenarioVersion", revision.Number] · @revision.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</option> }</select></div></div>
<p class="micro">@T["ScenarioSourceHelp"] <a asp-page="/Evaluations/Offers/Details" asp-route-id="@e.Id" asp-route-offerId="@offer.Id" asp-route-revision="@Model.Input.RevisionNumber" target="_blank" rel="noopener">@T["ScenarioOpenSource"] ↗</a></p>
<div class="scenario-number-grid">
@foreach (var field in ScenarioForm.Fields)
{ <div data-scenario-modes="@field.Modes"><label for="scenario-@field.Name">@T["Scenario" + field.Name]</label><input id="scenario-@field.Name" name="Input.Values[@field.Name]" value="@Model.Input.Value(field.Name)" type="number" min="0" max="@field.Max" step="@field.Step" inputmode="decimal" /><p class="micro">@T["Scenario" + field.Name + "Help"]</p></div> }
</div>
<div class="notice scenario-convention" data-scenario-modes="Financing">@T["ScenarioCreditConvention"]</div>
<div class="notice scenario-convention" data-scenario-modes="LeaseReturn LeaseBuyout">@T["ScenarioLeaseConvention"]</div>
<label asp-for="Input.Notes">@T["ScenarioNotes"]</label><textarea asp-for="Input.Notes" rows="3" maxlength="4000"></textarea>
<label class="scenario-check"><input asp-for="Input.CostsReviewed" /> <span>@T["ScenarioCostsReviewed"]</span></label><p class="micro">@T["ScenarioCostsReviewedHelp"]</p>
<div class="scenario-form-actions"><button class="button primary" id="save-scenario">@T["Save"]</button><a class="button secondary" asp-page="Index" asp-route-id="@e.Id">@T["Cancel"]</a></div>
</form></section>
}
@section Scripts { <script src="~/js/scenarios.js" asp-append-version="true" defer></script> }
