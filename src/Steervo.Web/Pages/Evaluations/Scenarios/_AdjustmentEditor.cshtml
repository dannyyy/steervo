@model Steervo.Web.Pages.Evaluations.Scenarios.DetailsModel
@{ var e = Model.Evaluation; }
<section id="adjustment-editor" class="inline-editor scenario-inline-editor" data-editor data-opener="@(Model.EditAdjustment ? "edit-adjustment-" + Model.Adjustment.CostId : "open-adjustment")" aria-labelledby="adjustment-editor-title" hidden="@(!Model.EditAdjustment && Model.FailedAction != "adjustment")" data-open-on-load="@Model.EditAdjustment.ToString().ToLowerInvariant()">
<div class="editor-heading"><div><p class="editor-context">@Model.Scenario.Name</p><h3 id="adjustment-editor-title">@T["ScenarioAdjustments"]</h3></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
<div class="editor-error" role="alert" tabindex="-1" hidden="@(Model.FailedAction != "adjustment")">@Model.Notice</div>
<form method="post" hx-post="@Model.ContextUrl" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-guard-draft data-retain-on-error id="adjustment-form" class="scenario-secondary-form"><input type="hidden" name="action" value="adjustment" /><input name="Version" value="@Model.Version" type="hidden" /><div class="scenario-number-grid"><div><label asp-for="Adjustment.CostId">@T["AdjustmentCost"]</label><select asp-for="Adjustment.CostId" data-editor-focus required><option value="">@T["Choose"]</option>@foreach (var cost in Model.Costs) { <option value="@cost.Id">@cost.Name · @T["CostFrequency" + cost.Frequency]</option> }</select></div><div><label asp-for="Adjustment.Amount">@T["AdjustmentAmount"] (@e.Currency)</label><input asp-for="Adjustment.Amount" type="number" min="0" max="1000000000000" step="0.01" /></div><div><label asp-for="Adjustment.StartMonth">@T["CostFirstMonth"]</label><input asp-for="Adjustment.StartMonth" type="number" min="1" max="1200" required /></div><div><label asp-for="Adjustment.EndMonth">@T["CostLastMonth"]</label><input asp-for="Adjustment.EndMonth" type="number" min="1" max="1200" /></div></div><label asp-for="Adjustment.Notes">@T["AdjustmentNotes"]</label><textarea asp-for="Adjustment.Notes" rows="2" maxlength="2000"></textarea><partial name="/Pages/Shared/_EditorActions.cshtml" model='new Steervo.Web.Pages.Shared.EditorActions("save-adjustment", T["AdjustmentSave"].Value)' /></form>
</section>
