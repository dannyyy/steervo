@model Steervo.Web.Pages.Evaluations.Scenarios.IndexModel
<section id="scenario-settings-editor" class="inline-editor" data-editor data-opener="open-scenario-settings" aria-labelledby="scenario-settings-editor-title" hidden="@(Model.Evaluation.CalculationSettings is not null && Model.FailedAction != "settings")">
<div class="editor-heading"><h3 id="scenario-settings-editor-title">@T["ScenarioSharedAssumption"]</h3><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
<div class="editor-error" role="alert" tabindex="-1" hidden="@(Model.FailedAction != "settings")">@Model.Notice</div>
<form method="post" class="scenario-return-form" hx-post="@Url.Page("Index", new { id = Model.Evaluation.Id })" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-guard-draft data-retain-on-error><input type="hidden" name="action" value="settings" /><input asp-for="Version" type="hidden" /><div><label asp-for="AnnualReturn">@T["ScenarioAnnualReturn"]</label><input asp-for="AnnualReturn" type="number" step="0.0001" min="-99" max="100" required data-editor-focus /></div><p class="editor-help">@T["ScenarioReturnHelp"]</p>
<partial name="/Pages/Shared/_EditorActions.cshtml" model='new Steervo.Web.Pages.Shared.EditorActions("save-scenario-settings")' />
</form></section>
