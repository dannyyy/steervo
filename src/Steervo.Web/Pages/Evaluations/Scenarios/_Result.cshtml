@model Steervo.Web.Pages.Evaluations.Scenarios.ScenarioPanel
@{
    var result = Model.Result;
    var evaluation = Model.Evaluation;
    var scenario = Model.Scenario;

    var openLabel = T["OfferOpen"].Value;
    var completeness = result.Complete ? "complete" : "incomplete";
    var horizonDate = evaluation.CostPlanning!.DateFor(result.Month).ToString("MM.yyyy");

    // Amounts that depend on the opportunity calculation stay open while the calculation has issues.
    var calculationComplete = result.Issues.Count == 0;
    decimal? netPayments = result.Months.Count == 0 ? null : result.NetPayments;

    // A leased vehicle that is returned has no residual value, so there is no band to show.
    var keepsVehicle = scenario.Terms.Mode != AcquisitionMode.LeaseReturn;

    string Money(decimal? value) =>
        value.HasValue ? $"{value:N2} {evaluation.Currency}" : openLabel;
}
<section
    class="scenario-result @completeness"
    data-result-scenario="@scenario.Id"
    data-result-complete="@result.Complete.ToString().ToLowerInvariant()"
>
    <p class="eyebrow">@T["Acquisition" + scenario.Terms.Mode]</p>
    <h3>@T["ScenarioResultTitle"]</h3>
    <p class="micro">@T["ScenarioAtMonth", result.Month, horizonDate]</p>
    <p class="scenario-result-label">@T["CalculationEffectiveCost"]</p>
    <p
        class="scenario-result-total"
        data-effective-cost="@result.ExpectedCost?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
    >@Money(result.ExpectedCost)</p>
    @if (result.ExpectedCost.HasValue)
    {
        <p class="scenario-monthly">@Money(result.ExpectedCost / result.Month) @T["CalculationPerMonth"]</p>
    }
    <partial name="_ResultGaps" model="Model" />
    <dl class="scenario-result-values">
        <div>
            <dt>@T["CalculationNetPayments"]</dt>
            <dd>@Money(netPayments)</dd>
        </div>
        <div>
            <dt>@T["CalculationOpportunity"]</dt>
            <dd>@(calculationComplete ? Money(result.OpportunityCost) : openLabel)</dd>
        </div>
        <div>
            <dt>@T["CalculationRemainingDebt"]</dt>
            <dd>@(calculationComplete ? Money(result.Debt) : openLabel)</dd>
        </div>
        <div>
            <dt>@T["CalculationResidualDeduction"]</dt>
            <dd>@Money(result.ExpectedResidual)</dd>
        </div>
    </dl>
    @if (keepsVehicle)
    {
        <div class="scenario-band">
            <div>
                <span>@T["ResidualLow"]</span>
                <strong>@Money(result.PessimisticCost)</strong>
            </div>
            <div>
                <span>@T["ResidualExpected"]</span>
                <strong>@Money(result.ExpectedCost)</strong>
            </div>
            <div>
                <span>@T["ResidualHigh"]</span>
                <strong>@Money(result.OptimisticCost)</strong>
            </div>
        </div>
        <p class="micro">@T["ScenarioBandHelp"]</p>
    }
    <details class="scenario-wealth">
        <summary>@T["CalculationWealth"]</summary>
        <dl class="scenario-result-values">
            <div>
                <dt>@T["CalculationReferenceCapital"]</dt>
                <dd>@Money(result.ReferenceCapital)</dd>
            </div>
            <div>
                <dt>@T["CalculationAccount"]</dt>
                <dd>@Money(result.Account)</dd>
            </div>
            <div>
                <dt>@T["CalculationFinalWealth"]</dt>
                <dd>@Money(result.ExpectedWealth)</dd>
            </div>
        </dl>
        <p class="micro">@T["CalculationReferenceHelp"]</p>
    </details>
</section>
