@model Steervo.Web.Pages.Evaluations.Scenarios.DetailsModel
@{ var e = Model.Evaluation; }
<section id="residual-editor" class="inline-editor scenario-inline-editor" data-editor data-opener="@(Model.EditResidual ? "edit-residual-" + Model.Residual.Month : "open-residual")" aria-labelledby="residual-editor-title" hidden="@(!Model.EditResidual && Model.FailedAction != "residual")" data-open-on-load="@Model.EditResidual.ToString().ToLowerInvariant()">
<div class="editor-heading"><div><p class="editor-context">@Model.Scenario.Name</p><h3 id="residual-editor-title">@T["ScenarioResiduals"]</h3></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
<div class="editor-error" role="alert" tabindex="-1" hidden="@(Model.FailedAction != "residual")">@Model.Notice</div>
<form method="post" hx-post="@Model.ContextUrl" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-guard-draft data-retain-on-error id="residual-form" class="scenario-secondary-form"><input type="hidden" name="action" value="residual" /><input name="Version" value="@Model.Version" type="hidden" />
<div class="scenario-residual-fields"><div><label asp-for="Residual.Month">@T["ScenarioCheckpoint"]</label><input asp-for="Residual.Month" data-editor-focus type="number" min="1" max="1200" required /></div><div><label asp-for="Residual.Low">@T["ResidualLow"] (@e.Currency)</label><input asp-for="Residual.Low" type="number" min="0" max="1000000000000" step="0.01" /></div><div><label asp-for="Residual.Expected">@T["ResidualExpected"] (@e.Currency)</label><input asp-for="Residual.Expected" type="number" min="0" max="1000000000000" step="0.01" /></div><div><label asp-for="Residual.High">@T["ResidualHigh"] (@e.Currency)</label><input asp-for="Residual.High" type="number" min="0" max="1000000000000" step="0.01" /></div></div>
<label asp-for="Residual.Notes">@T["ResidualNotes"]</label><textarea asp-for="Residual.Notes" rows="2" maxlength="2000"></textarea><partial name="/Pages/Shared/_EditorActions.cshtml" model='new Steervo.Web.Pages.Shared.EditorActions("save-residual", T["ResidualSave"].Value)' /><p class="micro">@T["ResidualSaveHelp"]</p></form>
</section>
