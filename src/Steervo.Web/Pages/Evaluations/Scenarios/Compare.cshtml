@page "/evaluations/{id:guid}/scenarios/compare"
@model Steervo.Web.Pages.Evaluations.Scenarios.CompareModel
@using Steervo.Web.Pages.Evaluations.Scenarios
@{
    var evaluation = Model.Evaluation;
    ViewData["Title"] = T["ScenarioCompare"].Value;

    string Money(decimal? value) =>
        value.HasValue ? $"{value:N2} {evaluation.Currency}" : T["OfferOpen"].Value;
}
<partial
    name="/Pages/Evaluations/_EvaluationHeader.cshtml"
    model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(evaluation, Model.Access, "scenarios")'
/>
<a class="back-link" asp-page="Index" asp-route-id="@evaluation.Id">
    <partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T["ScenarioAll"]
</a>
<section class="comparison-surface scenario-comparison">
    <div class="comparison-introduction">
        <h2>@T["ScenarioCompare"]</h2>
        <p class="muted">@T["ScenarioCompareHelp"]</p>
    </div>
    <form method="get" class="comparison-picker scenario-compare-picker">
        <div>
            <label for="scenario-left">@T["ScenarioLeft"]</label>
            <select id="scenario-left" name="leftId" required>
                <option value="">@T["Choose"]</option>
                @foreach (var scenario in Model.SortedScenarios)
                {
                    <option value="@scenario.Id" selected="@(scenario.Id == Model.LeftId)">@scenario.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="scenario-right">@T["ScenarioRight"]</label>
            <select id="scenario-right" name="rightId" required>
                <option value="">@T["Choose"]</option>
                @foreach (var scenario in Model.SortedScenarios)
                {
                    <option value="@scenario.Id" selected="@(scenario.Id == Model.RightId)">@scenario.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="compare-month">@T["ScenarioCheckpoint"]</label>
            <input
                id="compare-month"
                name="month"
                value="@Model.Month"
                type="number"
                min="1"
                max="@evaluation.CostPlanning!.Months"
                required
            />
        </div>
        <button class="button primary">@T["ScenarioCalculate"]</button>
    </form>
    @if (Model.Left is { } left && Model.Right is { } right)
    {
        var panels = Model.Panels;
        var horizonDate = evaluation.CostPlanning!.DateFor(Model.Month).ToString("MM.yyyy");

        if (Model.CostDifference is { } difference)
        {
            <div
                class="scenario-comparison-summary"
                data-cost-difference="@difference.ToString(System.Globalization.CultureInfo.InvariantCulture)"
            >
                @if (Model.CostsEqual)
                {
                    <h3>@T["ScenarioEqualCost"]</h3>
                }
                else
                {
                    <h3>@T["ScenarioDifference", Model.CheaperScenarioName, difference.ToString("N2"), evaluation.Currency!]</h3>
                    <p>@T["ScenarioMonthlyDifference", Model.MonthlyCostDifference.ToString("N2"), evaluation.Currency!, Model.Month]</p>
                }
                <p class="micro">@T["ScenarioCompareBandHelp"]</p>
                @if (Model.ResidualThreshold is { } threshold)
                {
                    <p class="scenario-threshold">@T[Model.ResidualThresholdLabel, left.Scenario.Name, threshold.ToString("N2"), evaluation.Currency!, right.Scenario.Name]</p>
                }
            </div>
        }
        else
        {
            <p class="notice scenario-convention">@T["ScenarioCompareIncomplete"]</p>
        }

        <p class="comparison-scroll-hint" id="scenario-scroll-hint">@T["ComparisonScrollHint"]</p>
        <div
            id="scenario-comparison-scroll"
            class="comparison-scroll"
            tabindex="0"
            role="region"
            aria-label="@T["ScenarioComparisonRegion"]"
            aria-describedby="scenario-scroll-hint"
            data-focus-scenario="@Request.Query["focus"]"
        >
            <table class="vehicle-table scenario-table">
                <caption class="visually-hidden">@T["ScenarioCompare"] · @T["ScenarioAtMonth", Model.Month, horizonDate]</caption>
                <colgroup>
                    <col class="criterion-column" />
                    <col />
                    <col />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">@T["ScenarioAtMonth", Model.Month, horizonDate]</th>
                        @foreach (var panel in panels)
                        {
                            var offer = evaluation.FindOffer(panel.Scenario.OfferId);
                            <th scope="col" data-scenario-column="@panel.Scenario.Id">
                                <a
                                    class="comparison-candidate-link"
                                    asp-page="Details"
                                    asp-route-id="@evaluation.Id"
                                    asp-route-scenarioId="@panel.Scenario.Id"
                                    asp-route-month="@Model.Month"
                                    asp-route-leftId="@Model.LeftId"
                                    asp-route-rightId="@Model.RightId"
                                >
                                    @panel.Scenario.Name<partial name="/Pages/Shared/_Icon.cshtml" model='"arrow"' />
                                </a>
                                <p class="micro">@evaluation.FindCandidate(offer.CandidateId).DisplayName</p>
                                <p class="micro">@T["Acquisition" + panel.Scenario.Terms.Mode] · @T["ScenarioVersion", panel.Scenario.RevisionNumber]</p>
                                @if (Model.CanEdit)
                                {
                                    <a
                                        class="text-link"
                                        asp-page="Edit"
                                        asp-route-id="@evaluation.Id"
                                        asp-route-scenarioId="@panel.Scenario.Id"
                                        asp-route-month="@Model.Month"
                                        asp-route-leftId="@Model.LeftId"
                                        asp-route-rightId="@Model.RightId"
                                    >
                                        @T["ScenarioEdit"]
                                    </a>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr class="scenario-result-row">
                        <th scope="row" class="vehicle-criterion">
                            <strong>@T["CalculationEffectiveCost"]</strong>
                        </th>
                        @foreach (var panel in panels)
                        {
                            <td
                                class="vehicle-value"
                                data-result-scenario="@panel.Scenario.Id"
                                data-result-complete="@panel.Result.Complete.ToString().ToLowerInvariant()"
                            >
                                <p
                                    class="scenario-result-total"
                                    data-effective-cost="@panel.Result.ExpectedCost?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                >@Money(panel.Result.ExpectedCost)</p>
                                @if (panel.Result.ExpectedCost.HasValue)
                                {
                                    <p class="scenario-monthly">@Money(panel.Result.ExpectedCost / Model.Month) @T["CalculationPerMonth"]</p>
                                }
                                <partial name="_ResultGaps" model="panel" />
                            </td>
                        }
                    </tr>
                    @foreach (var row in CompareModel.CostRows)
                    {
                        <tr>
                            <th scope="row" class="vehicle-criterion">@T[row.Label]</th>
                            @foreach (var panel in panels)
                            {
                                <td class="vehicle-value">@Money(row.Value(panel))</td>
                            }
                        </tr>
                    }
                </tbody>
                @if (Model.ShowResidualBand)
                {
                    <tbody>
                        <tr class="vehicle-group-heading">
                            <th colspan="3" scope="colgroup">
                                <span class="comparison-group-label">@T["ScenarioBandTitle"]<span class="micro">@T["ScenarioBandHelp"]</span></span>
                            </th>
                        </tr>
                        @foreach (var row in CompareModel.ResidualBandRows)
                        {
                            <tr>
                                <th scope="row" class="vehicle-criterion">@T[row.Label]</th>
                                @foreach (var panel in panels)
                                {
                                    var returnsVehicle = panel.Scenario.Terms.Mode == AcquisitionMode.LeaseReturn;
                                    <td class="vehicle-value">@(returnsVehicle ? T["ScenarioNotApplicable"].Value : Money(row.Value(panel)))</td>
                                }
                            </tr>
                        }
                    </tbody>
                }
                <tbody>
                    <tr class="vehicle-group-heading">
                        <th colspan="3" scope="colgroup">
                            <span class="comparison-group-label">@T["CalculationWealth"]<span class="micro">@T["CalculationReferenceHelp"]</span></span>
                        </th>
                    </tr>
                    @foreach (var row in CompareModel.WealthRows)
                    {
                        <tr>
                            <th scope="row" class="vehicle-criterion">@T[row.Label]</th>
                            @foreach (var panel in panels)
                            {
                                <td class="vehicle-value">@Money(row.Value(panel))</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="canvas-empty">
            <p>@T["ScenarioCompareSelect"]</p>
        </div>
    }
</section>
@section Scripts {
    <script src="~/js/scenarios.js" asp-append-version="true" defer></script>
}
