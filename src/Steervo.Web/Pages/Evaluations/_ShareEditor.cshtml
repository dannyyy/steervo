@model Steervo.Web.Pages.Evaluations.ShareEditor
@using Steervo.Web.Pages.Shared
@{
    var workspace = Model.Workspace; var e = workspace.Evaluation; var fresh = Model.UserId == "new";
    var failed = workspace.FailedAction == "share" && workspace.Request.Form["editorId"] == Model.UserId;
}
<div id="share-editor-@Model.UserId" class="inline-editor" data-editor data-opener="@(fresh ? "add-share" : "edit-share-" + Model.UserId)" hidden="@(!failed)" aria-labelledby="share-title-@Model.UserId">
    <div class="editor-heading"><div><p class="editor-context">@(fresh ? e.Name : Model.Email)</p><h3 id="share-title-@Model.UserId">@T[fresh ? "GrantAccess" : "EditPermission"]</h3></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
    <div class="editor-error" role="alert" tabindex="-1" hidden="@(!failed)">@(failed ? workspace.Notice : null)</div>
    <form method="post" hx-post="/evaluations/@e.Id?section=sharing" class="@(fresh ? "share-form" : "share-edit-form")" data-guard-draft data-submitted-values="@(failed ? workspace.SubmittedValues : null)"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="share" /><input type="hidden" name="editorId" value="@Model.UserId" />
        <div><label for="share-email-@Model.UserId">@T["Email"]</label><input id="share-email-@Model.UserId" name="email" type="email" value="@Model.Email" required maxlength="254" readonly="@(!fresh)" /></div>
        <div><label for="share-access-@Model.UserId">@T["Permission"]</label><select id="share-access-@Model.UserId" name="access"><option value="Reader" selected="@(Model.Access == AccessLevel.Reader)">@T["Reader"]</option><option value="Editor" selected="@(Model.Access == AccessLevel.Editor)">@T["Editor"]</option></select><p class="editor-help">@T["PermissionHelp"]</p></div>
        <partial name="/Pages/Shared/_EditorActions.cshtml" model='new EditorActions("save-share-" + Model.UserId, fresh ? T["GrantAccess"].Value : null)' />
    </form>
</div>
