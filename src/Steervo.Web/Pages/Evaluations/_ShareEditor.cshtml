@model Steervo.Web.Pages.Evaluations.ShareEditor
@using Steervo.Web.Pages.Shared
@{
    var workspace = Model.Workspace;
    var evaluation = workspace.Evaluation;
    var userId = Model.UserId;
    var submitLabel = Model.IsNew ? T["GrantAccess"].Value : null;
    var actions = new EditorActions("save-share-" + userId, submitLabel);
}
<div
    id="share-editor-@userId"
    class="inline-editor"
    data-editor
    data-opener="@Model.OpenerId"
    hidden="@(!Model.Failed)"
    aria-labelledby="share-title-@userId"
>
    <div class="editor-heading">
        <div>
            <p class="editor-context">@(Model.IsNew ? evaluation.Name : Model.Email)</p>
            <h3 id="share-title-@userId">@T[Model.IsNew ? "GrantAccess" : "EditPermission"]</h3>
        </div>
        <button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]">
            <partial name="/Pages/Shared/_Icon.cshtml" model='"close"' />
        </button>
    </div>
    <div
        class="editor-error"
        role="alert"
        tabindex="-1"
        hidden="@(!Model.Failed)"
    >@(Model.Failed ? workspace.Notice : null)</div>
    <form
        method="post"
        hx-post="/evaluations/@evaluation.Id?section=sharing"
        class="@(Model.IsNew ? "share-form" : "share-edit-form")"
        data-guard-draft
        data-submitted-values="@Model.Draft"
    >
        <input type="hidden" name="version" value="@evaluation.Version" />
        <input type="hidden" name="action" value="share" />
        <input type="hidden" name="editorId" value="@userId" />
        <div>
            <label for="share-email-@userId">@T["Email"]</label>
            <input
                id="share-email-@userId"
                name="email"
                type="email"
                value="@Model.Email"
                required
                maxlength="254"
                readonly="@(!Model.IsNew)"
            />
        </div>
        <div>
            <label for="share-access-@userId">@T["Permission"]</label>
            <select id="share-access-@userId" name="access">
                <option value="Reader" selected="@(Model.Access == AccessLevel.Reader)">@T["Reader"]</option>
                <option value="Editor" selected="@(Model.Access == AccessLevel.Editor)">@T["Editor"]</option>
            </select>
            <p class="editor-help">@T["PermissionHelp"]</p>
        </div>
        <partial name="/Pages/Shared/_EditorActions.cshtml" model="actions" />
    </form>
</div>
