@model Steervo.Web.Pages.Evaluations.EvaluationHeader
@{
    var e = Model.Evaluation;
    var candidatesUrl = Model.CandidateId.HasValue ? $"/evaluations/{e.Id}/candidates/{Model.CandidateId}?first={Model.First}&second={Model.Second}" : $"/evaluations/{e.Id}/candidates";
    var comparisonUrl = Model.First.HasValue ? $"/evaluations/{e.Id}/compare?first={Model.First}&second={Model.Second}" : $"/evaluations/{e.Id}/compare";
}
<div class="evaluation-context">
    <div class="evaluation-breadcrumb"><a asp-page="/Index"><partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T["AllEvaluations"]</a><span>@T[Model.Access.ToString()]</span></div>
    <div class="page-heading"><div><h1>@e.Name</h1>@if (!string.IsNullOrEmpty(e.Purpose)) { <p class="muted">@e.Purpose</p> }</div><div class="evaluation-summary"><span>@T["CriterionCount", e.Criteria.Count] · @T[e.Candidates.Count == 1 ? "CandidateCountSingle" : "CandidateCount", e.Candidates.Count]</span><a asp-page="/Evaluations/Details" asp-page-handler="Export" asp-route-id="@e.Id" class="text-link" download>@T["ExportEvaluation"]</a></div></div>
</div>
<nav class="section-nav" aria-label="@T["EvaluationNavigation"]">
    <a asp-page="/Evaluations/Details" asp-route-id="@e.Id" class="@(Model.Active == "criteria" ? "active" : null)" aria-current="@(Model.Active == "criteria" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"list"' />@T["Criteria"]</a>
    <a href="@candidatesUrl" class="@(Model.Active == "candidates" ? "active" : null)" aria-current="@(Model.Active == "candidates" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"car"' />@T["Candidates"]</a>
    <a href="@comparisonUrl" class="@(Model.Active == "comparison" ? "active" : null)" aria-current="@(Model.Active == "comparison" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"compare"' />@T["CompareCandidates"]</a>
    <a asp-page="/Evaluations/Offers/Index" asp-route-id="@e.Id" class="@(Model.Active == "offers" ? "active" : null)" aria-current="@(Model.Active == "offers" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"file"' />@T["Offers"]</a>
    <a asp-page="/Evaluations/Costs/Index" asp-route-id="@e.Id" class="@(Model.Active == "costs" ? "active" : null)" aria-current="@(Model.Active == "costs" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"wallet"' />@T["Costs"]</a>
    <a asp-page="/Evaluations/Scenarios/Index" asp-route-id="@e.Id" class="@(Model.Active == "scenarios" ? "active" : null)" aria-current="@(Model.Active == "scenarios" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"calculate"' />@T["Calculations"]</a>
    <a asp-page="/Evaluations/Details" asp-route-id="@e.Id" asp-route-section="sharing" class="@(Model.Active == "sharing" ? "active" : null)" aria-current="@(Model.Active == "sharing" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"people"' />@T["Access"]</a>
    @if (Model.Access >= AccessLevel.Editor) { <a asp-page="/Evaluations/Details" asp-route-id="@e.Id" asp-route-section="settings" class="@(Model.Active == "settings" ? "active" : null)" aria-current="@(Model.Active == "settings" ? "page" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"settings"' />@T["CaseSettings"]</a> }
</nav>
