@model Steervo.Web.Pages.Evaluations.EvaluationHeader
@{
    var evaluation = Model.Evaluation;
    var offersUrl = Url.Page(
        "/Evaluations/Offers/Index",
        new { id = evaluation.Id, candidateId = Model.CandidateId }
    );
    var candidateCountKey = evaluation.Candidates.Count == 1 ? "CandidateCountSingle" : "CandidateCount";
}
<div class="evaluation-context">
    <div class="evaluation-breadcrumb">
        <a asp-page="/Index">
            <partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />
            @T["AllEvaluations"]
        </a>
        <span>@T[Model.Access.ToString()]</span>
    </div>
    <div class="page-heading">
        <div>
            <h1>@evaluation.Name</h1>
            @if (!string.IsNullOrEmpty(evaluation.Purpose))
            {
                <p class="muted">@evaluation.Purpose</p>
            }
        </div>
        <div class="evaluation-summary">
            <span>@T["CriterionCount", evaluation.Criteria.Count] · @T[candidateCountKey, evaluation.Candidates.Count]</span>
        </div>
    </div>
</div>
<partial name="/Pages/Evaluations/_RegionalSettingsNotice.cshtml" model="Model" />
<nav class="section-nav workflow-nav" aria-label="@T["EvaluationNavigation"]">
    <a
        asp-page="/Evaluations/Details"
        asp-route-id="@evaluation.Id"
        class="@Model.StepClass("setup")"
        aria-current="@Model.StepCurrent("setup")"
    >
        <partial name="/Pages/Shared/_Icon.cshtml" model='"list"' />
        @T["WorkflowSetup"]
    </a>
    <a
        href="@Model.CandidatesUrl"
        class="@Model.StepClass("cars")"
        aria-current="@Model.StepCurrent("cars")"
    >
        <partial name="/Pages/Shared/_Icon.cshtml" model='"car"' />
        @T["WorkflowCars"]
    </a>
    <a
        href="@offersUrl"
        class="@Model.StepClass("offers")"
        aria-current="@Model.StepCurrent("offers")"
    >
        <partial name="/Pages/Shared/_Icon.cshtml" model='"wallet"' />
        @T["WorkflowOffers"]
    </a>
    <a
        href="@Model.ComparisonUrl"
        class="@Model.StepClass("results")"
        aria-current="@Model.StepCurrent("results")"
    >
        <partial name="/Pages/Shared/_Icon.cshtml" model='"compare"' />
        @T["WorkflowResults"]
    </a>
</nav>
@if (!Model.HasSections)
{
    <div class="workspace-subnav"></div>
}
else
{
    <nav class="workspace-subnav" aria-label="@T["WorkflowSections"]">
        @if (Model.Group == "setup")
        {
            <a
                asp-page="/Evaluations/Details"
                asp-route-id="@evaluation.Id"
                asp-route-section="settings"
                aria-current="@Model.PageCurrent("settings")"
            >@T["General"]</a>
            <a
                asp-page="/Evaluations/Details"
                asp-route-id="@evaluation.Id"
                asp-route-section="criteria"
                aria-current="@Model.PageCurrent("criteria")"
            >@T["Criteria"]</a>
        }
        else if (Model.Group == "offers")
        {
            <a href="@offersUrl" aria-current="@Model.PageCurrent("offers")">@T["Offers"]</a>
            <a
                asp-page="/Evaluations/Costs/Index"
                asp-route-id="@evaluation.Id"
                asp-route-candidateId="@Model.CandidateId"
                aria-current="@Model.PageCurrent("costs")"
            >@T["Costs"]</a>
        }
        else if (Model.Group == "results")
        {
            <a href="@Model.ComparisonUrl" aria-current="@Model.PageCurrent("comparison")">@T["VehicleComparison"]</a>
            <a
                asp-page="/Evaluations/Scenarios/Index"
                asp-route-id="@evaluation.Id"
                aria-current="@Model.PageCurrent("scenarios")"
            >@T["Calculations"]</a>
        }
    </nav>
}
