@model Steervo.Web.Pages.Evaluations.EvaluationHeader
@{
    var e = Model.Evaluation;
    var candidatesUrl = Model.CandidateId.HasValue ? $"/evaluations/{e.Id}/candidates/{Model.CandidateId}?first={Model.First}&second={Model.Second}" : $"/evaluations/{e.Id}/candidates";
    var comparisonUrl = Model.First.HasValue ? $"/evaluations/{e.Id}/compare?first={Model.First}&second={Model.Second}" : $"/evaluations/{e.Id}/compare";
    var offersUrl = Url.Page("/Evaluations/Offers/Index", new { id = e.Id, candidateId = Model.CandidateId });
    var group = Model.Active switch { "criteria" or "settings" => "setup", "candidates" => "cars", "offers" or "costs" => "offers", "comparison" or "scenarios" => "results", _ => "management" };
}
<div class="evaluation-context">
    <div class="evaluation-breadcrumb"><a asp-page="/Index"><partial name="/Pages/Shared/_Icon.cshtml" model='"back"' />@T["AllEvaluations"]</a><span>@T[Model.Access.ToString()]</span></div>
    <div class="page-heading"><div><h1>@e.Name</h1>@if (!string.IsNullOrEmpty(e.Purpose)) { <p class="muted">@e.Purpose</p> }</div><div class="evaluation-summary"><span>@T["CriterionCount", e.Criteria.Count] · @T[e.Candidates.Count == 1 ? "CandidateCountSingle" : "CandidateCount", e.Candidates.Count]</span></div></div>
</div>
<partial name="/Pages/Evaluations/_RegionalSettingsNotice.cshtml" model="Model" />
<nav class="section-nav workflow-nav" aria-label="@T["EvaluationNavigation"]">
    <a asp-page="/Evaluations/Details" asp-route-id="@e.Id" class="@(group == "setup" ? "active" : null)" aria-current="@(group == "setup" ? "true" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"list"' />@T["WorkflowSetup"]</a>
    <a href="@candidatesUrl" class="@(group == "cars" ? "active" : null)" aria-current="@(group == "cars" ? "true" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"car"' />@T["WorkflowCars"]</a>
    <a href="@offersUrl" class="@(group == "offers" ? "active" : null)" aria-current="@(group == "offers" ? "true" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"wallet"' />@T["WorkflowOffers"]</a>
    <a href="@comparisonUrl" class="@(group == "results" ? "active" : null)" aria-current="@(group == "results" ? "true" : null)"><partial name="/Pages/Shared/_Icon.cshtml" model='"compare"' />@T["WorkflowResults"]</a>
</nav>
@if (group is "cars" or "management") { <div class="workspace-subnav"></div> }
else {
<nav class="workspace-subnav" aria-label="@T["WorkflowSections"]">
@if (group == "setup") {
    <a asp-page="/Evaluations/Details" asp-route-id="@e.Id" asp-route-section="settings" aria-current="@(Model.Active == "settings" ? "page" : null)">@T["General"]</a>
    <a asp-page="/Evaluations/Details" asp-route-id="@e.Id" aria-current="@(Model.Active == "criteria" ? "page" : null)">@T["Criteria"]</a>
} else if (group == "offers") {
    <a href="@offersUrl" aria-current="@(Model.Active == "offers" ? "page" : null)">@T["Offers"]</a>
    <a asp-page="/Evaluations/Costs/Index" asp-route-id="@e.Id" asp-route-candidateId="@Model.CandidateId" aria-current="@(Model.Active == "costs" ? "page" : null)">@T["Costs"]</a>
} else if (group == "results") {
    <a href="@comparisonUrl" aria-current="@(Model.Active == "comparison" ? "page" : null)">@T["VehicleComparison"]</a>
    <a asp-page="/Evaluations/Scenarios/Index" asp-route-id="@e.Id" aria-current="@(Model.Active == "scenarios" ? "page" : null)">@T["Calculations"]</a>
}
</nav>
}
