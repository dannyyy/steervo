@model Steervo.Web.Pages.Evaluations.CriterionFields
@{ var c = Model.Criterion; var p = Model.Prefix; }
<label for="name-@p">@T["CriterionName"]</label><input id="name-@p" name="name" value="@c?.Name" required maxlength="160" />
<div class="field-pair"><div><label for="priority-@p">@T["Priority"]</label><select id="priority-@p" name="priority">@foreach (var v in Enum.GetValues<Priority>()) { <option value="@v" selected="@(v == (c?.Priority ?? Priority.Required))">@T[v.ToString()]</option> }</select></div><div><label for="scope-@p">@T["Scope"]</label><select id="scope-@p" name="scope">@foreach (var v in Enum.GetValues<CriterionScope>()) { <option value="@v" selected="@(v == (c?.Scope ?? CriterionScope.Vehicle))">@T[v.ToString()]</option> }</select></div></div>
<label for="type-@p">@T["CriterionType"]</label><select id="type-@p" name="type" data-criterion-type>@foreach (var v in Enum.GetValues<CriterionType>()) { <option value="@v" selected="@(v == (c?.Type ?? CriterionType.Boolean))">@T[v.ToString()]</option> }</select>
<div class="measurement-fields" data-measurement-fields><label for="comparison-@p">@T["Comparison"]</label><select id="comparison-@p" name="comparison">@foreach (var v in Enum.GetValues<Comparison>()) { <option value="@v" selected="@(v == (c?.Comparison ?? Comparison.AtLeast))">@T[v.ToString()]</option> }</select><div class="field-pair"><div><label for="threshold-@p">@T["Threshold"]</label><input id="threshold-@p" name="threshold" value="@c?.Threshold?.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="any" /></div><div><label for="unit-@p">@T["Unit"]</label><input id="unit-@p" name="unit" value="@c?.Unit" maxlength="30" /></div></div></div>
<label for="group-criterion-@p">@T["Group"]</label><select id="group-criterion-@p" name="groupId"><option value="">@T["Ungrouped"]</option>@foreach (var g in Model.Groups.OrderBy(x => x.Position)) { <option value="@g.Id" selected="@(g.Id == c?.GroupId)">@g.Name</option> }</select>
