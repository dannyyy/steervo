@model Steervo.Web.Pages.Evaluations.CriterionFields
@{
    var criterion = Model.Criterion;
    var prefix = Model.Prefix;
}
<label for="name-@prefix">@T["CriterionName"]</label>
<input id="name-@prefix" name="name" value="@criterion?.Name" required maxlength="160" />
<div class="field-pair">
    <div>
        <label for="priority-@prefix">@T["Priority"]</label>
        <select id="priority-@prefix" name="priority">
            @foreach (var priority in Enum.GetValues<Priority>())
            {
                <option value="@priority" selected="@(priority == Model.SelectedPriority)">@T[priority.ToString()]</option>
            }
        </select>
    </div>
    <div>
        <label for="scope-@prefix">@T["Scope"]</label>
        <select id="scope-@prefix" name="scope">
            @foreach (var scope in Enum.GetValues<CriterionScope>())
            {
                <option value="@scope" selected="@(scope == Model.SelectedScope)">@T[scope.ToString()]</option>
            }
        </select>
    </div>
</div>
<label for="type-@prefix">@T["CriterionType"]</label>
<select id="type-@prefix" name="type" data-criterion-type>
    @foreach (var type in Enum.GetValues<CriterionType>())
    {
        <option value="@type" selected="@(type == Model.SelectedType)">@T[type.ToString()]</option>
    }
</select>
<div class="measurement-fields" data-measurement-fields>
    <label for="comparison-@prefix">@T["Comparison"]</label>
    <select id="comparison-@prefix" name="comparison">
        @foreach (var comparison in Enum.GetValues<Comparison>())
        {
            <option value="@comparison" selected="@(comparison == Model.SelectedComparison)">@T[comparison.ToString()]</option>
        }
    </select>
    <div class="field-pair">
        <div>
            <label for="threshold-@prefix">@T["Threshold"]</label>
            <input id="threshold-@prefix" name="threshold" value="@Model.ThresholdValue" type="number" step="any" />
        </div>
        <div>
            <label for="unit-@prefix">@T["Unit"]</label>
            <input id="unit-@prefix" name="unit" value="@criterion?.Unit" maxlength="30" />
        </div>
    </div>
</div>
<label for="group-criterion-@prefix">@T["Group"]</label>
<select id="group-criterion-@prefix" name="groupId">
    <option value="">@T["Ungrouped"]</option>
    @foreach (var group in Model.GroupsInOrder)
    {
        <option value="@group.Id" selected="@(group.Id == criterion?.GroupId)">@group.Name</option>
    }
</select>
