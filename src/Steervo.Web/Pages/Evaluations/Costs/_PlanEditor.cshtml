@model Steervo.Web.Pages.Evaluations.Costs.IndexModel
<section id="cost-plan-editor" class="inline-editor cost-plan" data-editor data-opener="open-cost-plan" aria-labelledby="cost-plan-editor-title" hidden="@(Model.Evaluation.CostPlanning is not null && Model.FailedAction != "plan")">
<div class="editor-heading"><h3 id="cost-plan-editor-title">@T[Model.Evaluation.CostPlanning is null ? "CostPlanSetup" : "CostPlanChange"]</h3><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
<p class="editor-help">@T["CostPlanHelp"]</p><div class="editor-error" role="alert" tabindex="-1" hidden="@(Model.FailedAction != "plan")">@Model.Notice</div>
<form method="post" hx-post="@Model.ContextUrl" hx-swap="none" hx-sync="this:drop" hx-disabled-elt="find button[type=submit]" data-guard-draft data-retain-on-error class="cost-plan-form"><input type="hidden" name="action" value="plan" /><input asp-for="Version" type="hidden" />
<div><label asp-for="Plan.Start">@T["CostStart"]</label><input asp-for="Plan.Start" type="month" min="1900-01" max="9899-12" required data-editor-focus /></div>
<div><label asp-for="Plan.Months">@T["CostDuration"]</label><input asp-for="Plan.Months" type="number" min="1" max="1200" step="1" required /></div>
<partial name="/Pages/Shared/_EditorActions.cshtml" model='new Steervo.Web.Pages.Shared.EditorActions("save-cost-plan", T["CostSavePlan"].Value)' />
</form></section>
