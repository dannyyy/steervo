@model Steervo.Web.Pages.Evaluations.Candidates.CandidateForm
<div class="field-pair"><div><label for="candidate-brand">@T["CandidateBrand"] <span class="optional">@T["OptionalField"]</span></label><input id="candidate-brand" name="Input.Brand" value="@Model.Brand" maxlength="100" autocomplete="off" /></div><div><label for="candidate-model">@T["CandidateModel"]</label><input id="candidate-model" name="Input.Model" value="@Model.Model" required maxlength="160" /></div></div>
<label for="candidate-variant">@T["CandidateVariant"] <span class="optional">@T["OptionalField"]</span></label><input id="candidate-variant" name="Input.Variant" value="@Model.Variant" maxlength="160" />
<label for="candidate-condition">@T["CandidateCondition"]</label><select id="candidate-condition" name="Input.Condition">@foreach (var condition in Enum.GetValues<CandidateCondition>()) { <option value="@condition" selected="@(condition == Model.Condition)">@T["Condition" + condition]</option> }</select>
<div class="field-pair"><div><label for="candidate-year">@T["CandidateYear"] <span class="optional">@T["OptionalField"]</span></label><input id="candidate-year" name="Input.Year" value="@Model.Year" type="number" min="1" max="9999" step="1" /></div><div><label for="candidate-mileage">@T["CandidateMileage"] <span class="optional">@T["OptionalField"]</span></label><input id="candidate-mileage" name="Input.Mileage" value="@Model.Mileage" type="number" min="0" step="1" /></div></div>
<label for="candidate-notes">@T["CandidateNotes"] <span class="optional">@T["OptionalField"]</span></label><textarea id="candidate-notes" name="Input.Notes" maxlength="4000" rows="3">@Model.Notes</textarea>
<label for="candidate-links">@T["CandidateLinks"] <span class="optional">@T["OptionalField"]</span></label><textarea id="candidate-links" name="Input.Links" maxlength="12000" rows="2" aria-describedby="candidate-links-help">@Model.Links</textarea><p class="micro" id="candidate-links-help">@T["CandidateLinksHelp"]</p>

<partial name="_SpecificationsFields" model="Model.Specifications" />
