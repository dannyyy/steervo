@model Steervo.Web.Pages.Evaluations.Candidates.IndexModel
@{ var e = Model.Evaluation; var edit = Model.Access >= AccessLevel.Editor; }
<div id="candidate-workspace" data-version="@e.Version" data-preserve-viewport hx-target="#candidate-workspace" hx-swap="outerHTML show:none focus-scroll:false" hx-sync="this:drop">
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(e, Model.Access, "candidates")' />
@if (Model.Notice is not null) { <div class="notice workspace-notice @(Model.Failed ? "failure" : "success")" role="status" tabindex="-1">@Model.Notice</div> }
<div class="section-heading candidate-heading"><div><h2>@T["CandidatesTitle"]</h2><p class="muted">@T["CandidatesHelp"]</p></div>@if (edit) { <button type="button" class="button primary" data-dialog-open="new-candidate" aria-haspopup="dialog">＋ @T["AddCandidate"]</button> }</div>
@if (e.Candidates.Count == 0)
{
    <div class="candidate-empty"><span class="step-number">02</span><div><h3>@T["EmptyCandidatesTitle"]</h3><p>@T["EmptyCandidatesHelp"]</p></div></div>
}
else
{
    <div class="candidate-grid">
    @foreach (var c in e.Candidates.OrderBy(c => c.Position))
    {
        var failures = e.Criteria.Where(x => x.Scope == CriterionScope.Vehicle && x.Priority == Priority.Required && e.ResultFor(c.Id, x.Id) == Fulfillment.Unmet).ToList();
        var unknown = e.Criteria.Any(x => x.Scope == CriterionScope.Vehicle && e.ResultFor(c.Id, x.Id) == Fulfillment.Unknown);
        <article class="candidate-card" id="candidate-@c.Id" data-candidate-id="@c.Id">
            <div class="card-top"><span class="candidate-status @c.Status.ToString().ToLowerInvariant()">@T["CandidateStatus" + c.Status]</span>
            @if (edit) { <div class="row-actions">@foreach (var direction in new[] { -1, 1 }) { <form method="post" hx-post="/evaluations/@e.Id/candidates"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="move-candidate" /><input type="hidden" name="itemId" value="@c.Id" /><input type="hidden" name="direction" value="@direction" /><button id="move-candidate-@c.Id-@direction" class="icon-button" aria-label="@T[direction == -1 ? "CandidateUp" : "CandidateDown", c.DisplayName]" disabled="@(direction == -1 ? c.Position == 0 : c.Position == e.Candidates.Count - 1)">@(direction == -1 ? "↑" : "↓")</button></form> }</div> }</div>
            <h3><a asp-page="Details" asp-route-id="@e.Id" asp-route-candidateId="@c.Id">@c.DisplayName</a></h3><p class="muted candidate-meta">@T["Condition" + c.Condition] @if (c.Year.HasValue) { <span> · @c.Year</span> } @if (c.Mileage.HasValue) { <span> · @c.Mileage.Value.ToString("N0") km</span> }</p>
            @if (c.StatusReason.Length > 0) { <p class="candidate-reason">@c.StatusReason</p> }
            @if (failures.Count > 0) { <div class="candidate-warning"><strong>@T["RequiredNotMet"]</strong><p>@string.Join(" · ", failures.Select(x => x.Name))</p></div> }
            else { <p class="candidate-next">@T[unknown ? "CandidateNeedsAssessment" : "CandidateReadyToReview"]</p> }
            <a class="candidate-open" asp-page="Details" asp-route-id="@e.Id" asp-route-candidateId="@c.Id">@T[edit ? "AssessCandidate" : "ViewCandidate"] →</a>
            @if (edit)
            {
                <details class="candidate-actions"><summary>@T["CandidateActions"]</summary><form method="post"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="copy-candidate" /><input type="hidden" name="itemId" value="@c.Id" /><label for="copy-@c.Id">@T["CopyCandidateName"]</label><input id="copy-@c.Id" name="copyName" value="@c.Model" required maxlength="160" /><p class="micro">@T["CopyCandidateHelp"]</p><button class="button secondary">@T["CopyCandidate"]</button></form><form method="post" hx-post="/evaluations/@e.Id/candidates" data-confirm="@T["RemoveCandidateConfirm"]"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="remove-candidate" /><input type="hidden" name="itemId" value="@c.Id" /><button class="text-button danger">@T["RemoveCandidate"]</button></form></details>
            }
        </article>
    }
    </div>
    <div class="next-step"><div><strong>@T["CompareNextTitle"]</strong><p>@T["CompareNextHelp"]</p></div><a class="button secondary" asp-page="Compare" asp-route-id="@e.Id">@T["CompareCandidates"] →</a></div>
}
@if (edit)
{
    <dialog id="new-candidate" class="creation-dialog candidate-dialog" aria-labelledby="new-candidate-title" data-open-on-load="@(Model.CreationFailed ? "true" : "false")"><button type="button" class="dialog-close" data-dialog-close aria-label="@T["Close"]">×</button><p class="eyebrow">@T["Candidates"]</p><h2 id="new-candidate-title">@T["AddCandidate"]</h2><p class="muted">@T["NewCandidateHelp"]</p><form method="post"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="add-candidate" />@if (Model.CreationFailed) { <p class="notice failure" role="alert">@Model.Notice</p> }<partial name="_CandidateFields" model="Model.Input" /><div class="dialog-actions"><button type="button" class="button secondary" data-dialog-close>@T["Cancel"]</button><button class="button primary">@T["CreateCandidate"] →</button></div></form></dialog>
}
</div>
