@model Steervo.Web.Pages.Evaluations.Candidates.IndexModel
@using Steervo.Web.Pages.Shared
@using Steervo.Web.Pages.Evaluations.Candidates
@{
    var evaluation = Model.Evaluation;
    var canCompare = evaluation.Candidates.Count > 1;
}
<div
    id="candidate-workspace"
    data-version="@evaluation.Version"
    data-preserve-viewport
    hx-target="#candidate-workspace"
    hx-swap="outerHTML show:none focus-scroll:false"
    hx-sync="this:drop">
    <partial
        name="/Pages/Evaluations/_EvaluationHeader.cshtml"
        model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(evaluation, Model.Access, "candidates")' />
    @if (Model.Notice is not null && !Model.CreationFailed)
    {
        <div class="notice workspace-notice @(Model.Failed ? "failure" : "success")" role="status" tabindex="-1">@Model.Notice</div>
    }
    <div class="section-heading candidate-heading">
        <div>
            <h2>@T["CandidatesTitle"]</h2>
        </div>
        <div class="surface-actions">
            @if (canCompare)
            {
                <form
                    id="compare-selection"
                    method="get"
                    action="/evaluations/@evaluation.Id/compare"
                    data-compare-form
                    data-compare-maximum="@ComparisonSelection.Maximum">
                    <button class="button secondary" id="compare-selected" data-compare-label="@T["CompareCandidates"]">
                        <partial name="/Pages/Shared/_Icon.cshtml" model='"compare"' />
                        <span>@T["CompareCandidates"] (0/@ComparisonSelection.Maximum)</span>
                    </button>
                </form>
            }
            @if (Model.CanEdit)
            {
                <button
                    type="button"
                    class="button primary"
                    id="add-candidate"
                    data-dialog-open="new-candidate"
                    aria-haspopup="dialog">
                    <partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />
                    @T["AddCandidate"]
                </button>
            }
        </div>
    </div>
    @if (evaluation.Candidates.Count == 0)
    {
        <div class="candidate-empty">
            <partial name="/Pages/Shared/_Icon.cshtml" model='"car"' />
            <div>
                <h3>@T["EmptyCandidatesTitle"]</h3>
                <p>@T["EmptyCandidatesHelp"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="candidate-grid candidate-collection">
            @foreach (var candidate in Model.OrderedCandidates)
            {
                var summary = Model.SummaryFor(candidate);
                var unmetRequired = IndexModel.UnmetRequiredNames(summary);

                <article class="candidate-card" id="candidate-@candidate.Id" data-candidate-id="@candidate.Id">
                    <div class="candidate-identity">
                        <h3>
                            <a asp-page="Details" asp-route-id="@evaluation.Id" asp-route-candidateId="@candidate.Id">@candidate.DisplayName</a>
                        </h3>
                        <p class="candidate-tags">
                            <span class="candidate-status @candidate.Status.ToString().ToLowerInvariant()">@T["CandidateStatus" + candidate.Status]</span>
                            <span class="muted candidate-meta">
                                @T["Condition" + candidate.Condition]
                                @if (candidate.Year.HasValue)
                                {
                                    <span> · @candidate.Year</span>
                                }
                                @if (candidate.Mileage.HasValue)
                                {
                                    <span> · @candidate.Mileage.Value.ToString("N0") km</span>
                                }
                            </span>
                        </p>
                        @if (candidate.StatusReason.Length > 0)
                        {
                            <p class="candidate-reason">@candidate.StatusReason</p>
                        }
                    </div>
                    <div class="candidate-assessment-status">
                        @if (summary.Entries.Count == 0)
                        {
                            <p class="candidate-next">@T["CandidateNoCriteria"]</p>
                        }
                        else
                        {
                            <partial name="/Pages/Shared/_FulfillmentSummary.cshtml" model="summary" />
                        }
                        @if (unmetRequired.Count > 0)
                        {
                            <p class="candidate-warning"><strong>@T["RequiredNotMet"]:</strong> @string.Join(" · ", unmetRequired)</p>
                        }
                    </div>
                    <div class="candidate-side">
                        @if (Model.CanEdit)
                        {
                            <div class="row-actions">
                                @foreach (var direction in new[] { IndexModel.MoveUp, IndexModel.MoveDown })
                                {
                                    var movesUp = direction == IndexModel.MoveUp;

                                    <form method="post" hx-post="/evaluations/@evaluation.Id/candidates">
                                        <input type="hidden" name="version" value="@evaluation.Version" />
                                        <input type="hidden" name="action" value="move-candidate" />
                                        <input type="hidden" name="itemId" value="@candidate.Id" />
                                        <input type="hidden" name="direction" value="@direction" />
                                        <button
                                            id="move-candidate-@candidate.Id-@direction"
                                            class="icon-button"
                                            aria-label="@T[movesUp ? "CandidateUp" : "CandidateDown", candidate.DisplayName]"
                                            disabled="@Model.IsAtEnd(candidate, direction)">
                                            <partial name="/Pages/Shared/_Icon.cshtml" model='(movesUp ? "up" : "down")' />
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        @if (canCompare)
                        {
                            <label class="candidate-compare" for="compare-@candidate.Id">
                                <input
                                    type="checkbox"
                                    id="compare-@candidate.Id"
                                    form="compare-selection"
                                    name="more"
                                    value="@candidate.Id"
                                    data-compare-select />
                                <span>@T["CompareCandidates"]</span>
                            </label>
                        }
                    </div>
                </article>
            }
        </div>
    }
    @if (Model.CanEdit)
    {
        <dialog
            id="new-candidate"
            class="side-sheet"
            data-editor
            data-guard-draft
            data-opener="add-candidate"
            aria-labelledby="new-candidate-title"
            data-open-on-load="@(Model.CreationFailed ? "true" : "false")">
            <div class="editor-heading">
                <div>
                    <p class="editor-context">@T["Candidates"]</p>
                    <h2 id="new-candidate-title">@T["AddCandidate"]</h2>
                </div>
                <button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]">
                    <partial name="/Pages/Shared/_Icon.cshtml" model='"close"' />
                </button>
            </div>
            <p class="muted">@T["NewCandidateHelp"]</p>
            <form
                method="post"
                hx-post="/evaluations/@evaluation.Id/candidates"
                hx-disabled-elt="find button[type=submit]"
                data-guard-draft
                data-new-object>
                <input type="hidden" name="version" value="@evaluation.Version" />
                <input type="hidden" name="action" value="add-candidate" />
                @if (Model.CreationFailed)
                {
                    <p class="editor-error" role="alert" tabindex="-1">@Model.Notice</p>
                }
                <partial name="_CandidateFields" model="Model.Input" />
                <partial name="/Pages/Shared/_EditorActions.cshtml" model='new EditorActions("save-new-candidate", T["CreateCandidate"].Value)' />
            </form>
        </dialog>
    }
</div>
