@model Steervo.Web.Pages.Evaluations.Candidates.IndexModel
@using Steervo.Web.Pages.Shared
@using Steervo.Web.Pages.Evaluations.Candidates
@{ var e = Model.Evaluation; var edit = Model.Access >= AccessLevel.Editor; }
<div id="candidate-workspace" data-version="@e.Version" data-preserve-viewport hx-target="#candidate-workspace" hx-swap="outerHTML show:none focus-scroll:false" hx-sync="this:drop">
<partial name="/Pages/Evaluations/_EvaluationHeader.cshtml" model='new Steervo.Web.Pages.Evaluations.EvaluationHeader(e, Model.Access, "candidates")' />
@if (Model.Notice is not null && !Model.CreationFailed) { <div class="notice workspace-notice @(Model.Failed ? "failure" : "success")" role="status" tabindex="-1">@Model.Notice</div> }
<div class="section-heading candidate-heading"><div><h2>@T["CandidatesTitle"]</h2></div>
<div class="surface-actions">@if (e.Candidates.Count > 1) { <form id="compare-selection" method="get" action="/evaluations/@e.Id/compare" data-compare-form data-compare-maximum="@ComparisonSelection.Maximum"><button class="button secondary" id="compare-selected" data-compare-label="@T["CompareCandidates"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"compare"' /><span>@T["CompareCandidates"] (0/@ComparisonSelection.Maximum)</span></button></form> }
@if (edit) { <button type="button" class="button primary" id="add-candidate" data-dialog-open="new-candidate" aria-haspopup="dialog"><partial name="/Pages/Shared/_Icon.cshtml" model='"plus"' />@T["AddCandidate"]</button> }</div></div>
@if (e.Candidates.Count == 0)
{
    <div class="candidate-empty"><partial name="/Pages/Shared/_Icon.cshtml" model='"car"' /><div><h3>@T["EmptyCandidatesTitle"]</h3><p>@T["EmptyCandidatesHelp"]</p></div></div>
}
else
{
    <div class="candidate-grid candidate-collection">
    @foreach (var c in e.Candidates.OrderBy(c => c.Position))
    {
        var vehicleCriteria = e.Criteria.Where(x => x.Scope == CriterionScope.Vehicle).OrderBy(x => x.Position).ToList();
        var results = vehicleCriteria.Select(x => (Criterion: x, Result: e.ResultFor(c.Id, x.Id))).ToList();
        var failures = results.Where(x => x.Criterion.Priority == Priority.Required && x.Result == Fulfillment.Unmet).Select(x => x.Criterion.Name).ToList();
        var counts = new[] { Fulfillment.Met, Fulfillment.Unmet, Fulfillment.Optional, Fulfillment.Unknown, Fulfillment.Rated }.Select(state => (State: state, Count: results.Count(x => x.Result == state))).Where(x => x.Count > 0).ToList();
        var summary = string.Join(", ", counts.Select(x => T["Summary" + x.State, x.Count].Value));
        <article class="candidate-card" id="candidate-@c.Id" data-candidate-id="@c.Id">
            <div class="candidate-identity"><h3><a asp-page="Details" asp-route-id="@e.Id" asp-route-candidateId="@c.Id">@c.DisplayName</a></h3>
            <p class="candidate-tags"><span class="candidate-status @c.Status.ToString().ToLowerInvariant()">@T["CandidateStatus" + c.Status]</span><span class="muted candidate-meta">@T["Condition" + c.Condition]@if (c.Year.HasValue) { <span> · @c.Year</span> }@if (c.Mileage.HasValue) { <span> · @c.Mileage.Value.ToString("N0") km</span> }</span></p>
            @if (c.StatusReason.Length > 0) { <p class="candidate-reason">@c.StatusReason</p> }</div>
            <div class="candidate-assessment-status">
            @if (results.Count == 0) { <p class="candidate-next">@T["CandidateNoCriteria"]</p> }
            else
            {
                var offset = 0;
                <svg class="fulfillment-bar" viewBox="0 0 @results.Count 1" preserveAspectRatio="none" role="img" aria-label="@summary">@foreach (var item in counts) { <rect class="summary-@item.State.ToString().ToLowerInvariant()" x="@offset" y="0" width="@item.Count" height="1" /> offset += item.Count; }</svg>
                <ul class="fulfillment-counts">
                @foreach (var item in counts)
                {
                    var state = item.State.ToString().ToLowerInvariant();
                    <li class="summary-@state" data-summary="@item.State"><button type="button" class="summary-chip" id="summary-@c.Id-@state" aria-describedby="summary-list-@c.Id-@state">@T["Summary" + item.State, item.Count]</button>
                    <div class="summary-popover" role="tooltip" id="summary-list-@c.Id-@state"><strong>@T["Summary" + item.State, item.Count]</strong><ol>@foreach (var entry in results.Where(x => x.Result == item.State)) { <li><span>@entry.Criterion.Name@if (item.State == Fulfillment.Rated) { <em> · @(new AssessmentRow(e, c, entry.Criterion, Model.Access, "").ValueText)</em> }</span><span class="summary-priority @entry.Criterion.Priority.ToString().ToLowerInvariant()">@T[entry.Criterion.Priority.ToString()]</span></li> }</ol></div></li>
                }
                </ul>
            }
            @if (failures.Count > 0) { <p class="candidate-warning"><strong>@T["RequiredNotMet"]:</strong> @string.Join(" · ", failures)</p> }
            </div>
            <div class="candidate-side">
            @if (edit) { <div class="row-actions">@foreach (var direction in new[] { -1, 1 }) { <form method="post" hx-post="/evaluations/@e.Id/candidates"><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="move-candidate" /><input type="hidden" name="itemId" value="@c.Id" /><input type="hidden" name="direction" value="@direction" /><button id="move-candidate-@c.Id-@direction" class="icon-button" aria-label="@T[direction == -1 ? "CandidateUp" : "CandidateDown", c.DisplayName]" disabled="@(direction == -1 ? c.Position == 0 : c.Position == e.Candidates.Count - 1)"><partial name="/Pages/Shared/_Icon.cshtml" model='(direction == -1 ? "up" : "down")' /></button></form> }</div> }
            @if (e.Candidates.Count > 1) { <label class="candidate-compare" for="compare-@c.Id"><input type="checkbox" id="compare-@c.Id" form="compare-selection" name="more" value="@c.Id" data-compare-select /><span>@T["CompareCandidates"]</span></label> }
            </div>
        </article>
    }
    </div>
}
@if (edit)
{
    <dialog id="new-candidate" class="side-sheet" data-editor data-guard-draft data-opener="add-candidate" aria-labelledby="new-candidate-title" data-open-on-load="@(Model.CreationFailed ? "true" : "false")">
        <div class="editor-heading"><div><p class="editor-context">@T["Candidates"]</p><h2 id="new-candidate-title">@T["AddCandidate"]</h2></div><button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]"><partial name="/Pages/Shared/_Icon.cshtml" model='"close"' /></button></div>
        <p class="muted">@T["NewCandidateHelp"]</p>
        <form method="post" hx-post="/evaluations/@e.Id/candidates" hx-disabled-elt="find button[type=submit]" data-guard-draft data-new-object><input type="hidden" name="version" value="@e.Version" /><input type="hidden" name="action" value="add-candidate" />
            @if (Model.CreationFailed) { <p class="editor-error" role="alert" tabindex="-1">@Model.Notice</p> }
            <partial name="_CandidateFields" model="Model.Input" /><partial name="/Pages/Shared/_EditorActions.cshtml" model='new EditorActions("save-new-candidate", T["CreateCandidate"].Value)' />
        </form>
    </dialog>
}
</div>
