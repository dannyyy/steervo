@model Steervo.Web.Pages.Evaluations.Candidates.AssessmentRow
@using Steervo.Web.Pages.Evaluations.Candidates
@{
    var criterion = Model.Criterion;
    var answer = Model.AnswerKey is { } answerKey ? T[answerKey].Value : Model.ValueText;
    var source = Model.Assessment?.Source ?? AssessmentSource.Unknown;
}
<span class="assessment-label">
    <strong>@criterion.Name</strong>
    <span class="assessment-requirement">
        @T[criterion.Priority.ToString()]
        @if (criterion.Type == CriterionType.Measurement)
        {
            <span> · @AssessmentRow.ThresholdSign(criterion) @criterion.Threshold @criterion.Unit</span>
        }
        else
        {
            <span> · @T[criterion.Type.ToString()]</span>
        }
    </span>
</span>
<span class="assessment-answer">
    <strong>@answer</strong>
    <span>@T["AssessmentSource" + source]</span>
</span>
<span class="fulfillment @Model.Result.ToString().ToLowerInvariant()">@T["Fulfillment" + Model.Result]</span>
@if (Model.CanEdit)
{
    <span class="assessment-edit-icon">
        <partial name="/Pages/Shared/_Icon.cshtml" model='"edit"' />
    </span>
}
