@model Steervo.Web.Pages.Evaluations.Candidates.SpecificationsForm
@using Steervo.Web.Pages.Evaluations.Candidates
<div class="specifications-form" data-specifications data-calculated-label="@T["CalculatedValue"]">
    <h4>@T["VehicleSpecifications"] <span class="optional">@T["OptionalField"]</span></h4>
    <p class="micro">@T["SpecificationsHelp"]</p>
    @foreach (var group in SpecificationFields.Groups)
    {
        var helpKey = SpecificationFields.HelpKey(group.Key);

        <details class="specification-section" id="spec-section-@group.Key">
            <summary>@T["SpecGroup" + group.Key]</summary>
            @if (helpKey is not null)
            {
                <p class="micro">@T[helpKey]</p>
            }
            <div class="specification-grid">
                @if (group.Key == SpecificationFields.PerformanceGroup)
                {
                    <div>
                        <label for="spec-Propulsion">@T["SpecPropulsion"]</label>
                        <select id="spec-Propulsion" name="Input.Specifications.Propulsion">
                            <option value="">@T["NotSpecified"]</option>
                            @foreach (var value in Enum.GetValues<PropulsionType>())
                            {
                                <option value="@value" selected="@(Model.Propulsion == value)">@T["Propulsion" + value]</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="spec-Drive">@T["SpecDrive"]</label>
                        <select id="spec-Drive" name="Input.Specifications.Drive">
                            <option value="">@T["NotSpecified"]</option>
                            @foreach (var value in Enum.GetValues<DrivenWheels>())
                            {
                                <option value="@value" selected="@(Model.Drive == value)">@T["Drive" + value]</option>
                            }
                        </select>
                    </div>
                }
                @foreach (var field in group)
                {
                    <div class="specification-field">
                        <label for="spec-@field.Name">
                            @T[field.Label]
                            @if (field.Unit.Length > 0)
                            {
                                <span class="field-unit">(@field.Unit)</span>
                            }
                        </label>
                        <input
                            id="spec-@field.Name"
                            name="Input.Specifications.@field.Name"
                            value="@Model.Value(field.Name)"
                            type="number"
                            min="@field.Minimum"
                            max="1000000"
                            step="@field.Step"
                            inputmode="decimal"
                            data-spec-field="@field.Name"
                            data-unit="@field.Unit"
                            aria-describedby="@(field.HasCalculation ? "calculated-" + field.Name : null)" />
                        @if (field.HasCalculation)
                        {
                            <output
                                id="calculated-@field.Name"
                                for="spec-@field.Name"
                                class="specification-calculated"
                                data-calculated="@field.Name"
                                aria-live="polite"></output>
                        }
                    </div>
                }
            </div>
        </details>
    }
</div>
