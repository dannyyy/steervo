@model Steervo.Web.Pages.Evaluations.Candidates.AssessmentRow
@{
    var assessment = Model.Assessment;
    var answer = Model.AnswerKey is { } answerKey ? T[answerKey].Value : Model.ValueText;

    // The comparison has less room, so a rating is named by its short label.
    var resultKey = Model.Result == Fulfillment.Rated ? "FulfillmentRatedShort" : "Fulfillment" + Model.Result;
}
<span class="comparison-value">@answer</span>
<span class="fulfillment @Model.Result.ToString().ToLowerInvariant()">@T[resultKey]</span>
@if (assessment?.Source is { } source && source != AssessmentSource.Unknown)
{
    <span class="comparison-source">@T["AssessmentSource" + source]</span>
}
@if (!string.IsNullOrEmpty(assessment?.Notes))
{
    <span class="comparison-note">@assessment.Notes</span>
}
@if (Model.CanEdit)
{
    <span class="comparison-edit-icon">
        <partial name="/Pages/Shared/_Icon.cshtml" model='"edit"' />
    </span>
}
