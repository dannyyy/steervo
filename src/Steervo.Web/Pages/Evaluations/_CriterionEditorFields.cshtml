@model Steervo.Web.Pages.Evaluations.CriterionEditor
@using Steervo.Web.Pages.Evaluations
@using Steervo.Web.Pages.Shared
@{
    var criterion = Model.Criterion;
    var workspace = Model.Workspace;
    var evaluation = workspace.Evaluation;
    var fields = new CriterionFields(evaluation.Groups, criterion, Model.Prefix);
    var submitLabel = Model.IsNew ? T["AddCriterion"].Value : null;
    var actions = new EditorActions("save-criterion-" + Model.Prefix, submitLabel);
}
<div class="editor-heading">
    <div>
        <p class="editor-context">@(criterion?.Name ?? evaluation.Name)</p>
        <h3 id="@Model.TitleId">@T[Model.IsNew ? "AddCriterion" : "EditCriterion"]</h3>
    </div>
    <button type="button" class="icon-button" data-editor-close aria-label="@T["Close"]">
        <partial name="/Pages/Shared/_Icon.cshtml" model='"close"' />
    </button>
</div>
<div
    class="editor-error"
    role="alert"
    tabindex="-1"
    hidden="@(!Model.Failed)"
>@(Model.Failed ? workspace.Notice : null)</div>
<form
    method="post"
    hx-post="/evaluations/@evaluation.Id"
    data-guard-draft
    data-submitted-values="@Model.Draft"
    class="edit-fields"
>
    <input type="hidden" name="version" value="@evaluation.Version" />
    <input type="hidden" name="action" value="@Model.Action" />
    @if (criterion is not null)
    {
        <input type="hidden" name="itemId" value="@criterion.Id" />
    }
    <partial name="_CriterionFields" model="fields" />
    <partial name="/Pages/Shared/_EditorActions.cshtml" model="actions" />
</form>
@if (criterion is not null)
{
    <form
        method="post"
        hx-post="/evaluations/@evaluation.Id"
        class="editor-reset"
        data-confirm-action="@T["RemoveCriterionNamed", criterion.Name]"
        data-confirm-description="@T["RemoveCriterionConfirm"]"
    >
        <input type="hidden" name="version" value="@evaluation.Version" />
        <input type="hidden" name="action" value="remove-criterion" />
        <input type="hidden" name="itemId" value="@criterion.Id" />
        <button type="submit" class="text-button danger">@T["RemoveCriterion"]</button>
    </form>
}
